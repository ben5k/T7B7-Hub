    local function refreshMessages()
        local ok, data = http("GET", "/messages")
        if not ok or type(data) ~= "table" then return end
        loadMutes()
        local entries = {}
        for key, item in pairs(data) do
            if type(item) == "table" then
                table.insert(entries, {key = key, item = item})
            end
        end
        table.sort(entries, function(a, b)
            return (tonumber(a.item.time) or 0) < (tonumber(b.item.time) or 0)
        end)
        for _, entry in ipairs(entries) do
            if not lastMessageKeys[entry.key] then
                lastMessageKeys[entry.key] = true
                addMessage(entry.item)
            end
        end
        -- حدّ أعلى للذاكرة والواجهة

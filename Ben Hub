    local function makeDraggable(handle, target)
        local dragging = false
        local moved = false
        local dragInput, startInput, startPosition
        handle.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseButton1 then
                dragging = true
                moved = false
                dragInput = input
                startInput = input.Position
                startPosition = target.Position
            end
        end)
        ChatUIS.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType == Enum.UserInputType.Touch
                or input.UserInputType == Enum.UserInputType.MouseMovement then
                local delta = input.Position - startInput
                if delta.Magnitude > 6 then moved = true end
                target.Position = UDim2.new(
                    startPosition.X.Scale, startPosition.X.Offset + delta.X,
                    startPosition.Y.Scale, startPosition.Y.Offset + delta.Y
                )
            end
        end)
        ChatUIS.InputEnded:Connect(function(input)
            if input == dragInput then
                dragging = false
                dragInput = nil
                if moved then
                    target:SetAttribute("JustDragged", true)
                    task.delay(0.25, function()
                        if target and target.Parent then target:SetAttribute("JustDragged", false) end
                    end)
                end
            end
        end)
    end

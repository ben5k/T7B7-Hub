--========================================
-- سحب النافذة من الهيدر
--========================================
local wDragging = false
local wStart, wInputStart, wInput

header.InputBegan:Connect(function(input)
    if isPointer(input) then
        wDragging = true
        wInput = input
        wStart = main.Position
        wInputStart = input.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not wDragging then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or (input.UserInputType == Enum.UserInputType.Touch and input == wInput) then
        local d = input.Position - wInputStart
        main.Position = UDim2.new(
            wStart.X.Scale,wStart.X.Offset+d.X,
            wStart.Y.Scale,wStart.Y.Offset+d.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == wInput then
        wDragging = false
        wInput = nil
    end
end)

--========================================
-- سحب الفقاعة والضغط عليها
--========================================
local dragging = false
local moved = false
local startPos
local startInput
local activeInput

bubble.InputBegan:Connect(function(input)
    if isPointer(input) then
        dragging = true
        moved = false
        activeInput = input
        startPos = bubble.Position
        startInput = input.Position
        TweenService:Create(bubbleScale,TweenInfo.new(0.1),{Scale=0.9}):Play()
    end
end)

UIS.InputChanged:Connect(function(input)
    if not dragging then return end
    if input.UserInputType == Enum.UserInputType.Touch
    or input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position-startInput
        if delta.Magnitude > 8 then moved = true end
        if moved then
            bubble.Position = UDim2.new(
                startPos.X.Scale,startPos.X.Offset+delta.X,
                startPos.Y.Scale,startPos.Y.Offset+delta.Y
            )
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if not dragging or input ~= activeInput then return end
    dragging = false
    activeInput = nil
    TweenService:Create(bubbleScale,
        TweenInfo.new(0.18,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
        {Scale=1}):Play()
    if not moved then toggle() end
end)


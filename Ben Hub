local function renderHome(animate)
    clear()
    order = 0
    setContentArea(true)
    title.Text = "قائمة المابات"
    refreshChips()

    local list = {}
    for i,map in ipairs(Maps) do
        if matches(map.Name) and (tab == "all" or Favs[map.Name]) then
            table.insert(list,{map=map,i=i})
        end
    end

    table.sort(list,function(a,b)
        local fa = Favs[a.map.Name] and 1 or 0
        local fb = Favs[b.map.Name] and 1 or 0
        if fa ~= fb then return fa > fb end
        return a.i < b.i
    end)

    if #list == 0 then
        emptyMessage()
        return
    end

    for n,item in ipairs(list) do

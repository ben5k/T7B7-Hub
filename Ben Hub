local function runLoader(text,duration)
    placeLoader()
    loaderStatus.Text = text
    loaderPct.Text = "0%"
    fill.Size = UDim2.new(0,0,1,0)
    loaderScale.Scale = 0.6
    loader.Visible = true

    TweenService:Create(loaderScale,
        TweenInfo.new(0.25,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
        {Scale=1}):Play()

    local start = os.clock()
    while true do
        local a = math.clamp((os.clock()-start)/duration,0,1)
        local e = a*a*(3-2*a)
        fill.Size = UDim2.new(e,0,1,0)
        loaderPct.Text = math.floor(e*100).."%"
        if a >= 1 then break end
        task.wait()
    end

    task.wait(0.1)
    local tout = TweenService:Create(loaderScale,
        TweenInfo.new(0.2,Enum.EasingStyle.Back,Enum.EasingDirection.In),
        {Scale=0.01})
    tout:Play()
    tout.Completed:Wait()
    loader.Visible = false
end


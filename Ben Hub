    end

    local function http(method, path, body)
        local url = DB .. ROOT .. path .. ".json"
        local payload = {
            Url = url,
            Method = method,
            Headers = {["Content-Type"] = "application/json"},
        }
        if body ~= nil then payload.Body = encode(body) end

        local req = (syn and syn.request) or (http_request) or (request)
        if req then
            local response = req(payload)
            if response and response.Body then
                return response.StatusCode and response.StatusCode < 400, decode(response.Body)
            end
            return response ~= nil, nil
        end

        local ok, result = pcall(function()
            if method == "GET" then

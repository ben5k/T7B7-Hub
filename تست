local function playSound(id, vol)
	if not Config.Sounds or not id or id == "" then return end
	pcall(function() local s = Instance.new("Sound"); s.SoundId = id; s.Volume = vol or 0.6; s.Parent = SoundService; s.Ended:Connect(function() s:Destroy() end); s:Play(); task.delay(6, function() if s.Parent then s:Destroy() end end) end)
end
local function click() playSound(Config.ClickSound, 0.5) end
local function pressFx(btn, strength, silent)
	local sc = new("UIScale", { Parent = btn })
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 1 - (strength or 0.05) }):Play() end)
	local function up() tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back):Play() end
	btn.MouseButton1Up:Connect(up); btn.MouseLeave:Connect(up)
	if not silent then btn.MouseButton1Click:Connect(click) end
end

--// Remote images (downloaded through the executor)
local Assets, Waiters = {}, {}
local function useAsset(key, fn) if Assets[key] then task.spawn(fn, Assets[key]) else Waiters[key] = Waiters[key] or {}; table.insert(Waiters[key], fn) end end
local function setAsset(key, a) Assets[key] = a; for _, fn in ipairs(Waiters[key] or {}) do task.spawn(fn, a) end end
local function downloadImage(url, file)
	if not url or url == "" then return nil end
	if typeof(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then return nil end
	local data
	local req = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request) or (typeof(syn) == "table" and syn.request) or nil
	if req then local ok, res = pcall(req, { Url = url, Method = "GET", Headers = { Referer = "https://top4top.io/", ["User-Agent"] = "Mozilla/5.0" } }); if ok and res and type(res.Body) == "string" and string.sub(res.Body, 2, 4) == "PNG" then data = res.Body end end
	if not data then local ok, body = pcall(function() return game:HttpGet(url) end); if ok and type(body) == "string" and string.sub(body, 2, 4) == "PNG" then data = body end end
	if not data then return nil end
	local ok, asset = pcall(function() writefile(file, data); return getcustomasset(file) end)
	return ok and asset or nil
end

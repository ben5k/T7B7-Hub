    nameLbl.ZIndex = 7
    nameLbl.Parent = LoadFrame

    -- العنوان الكبير (غيّر الكلمة من هنا)
    local HUB_TITLE = "K  E  O  N"
    local titleShadow = Instance.new("TextLabel")
    titleShadow.Size = UDim2.new(1, 0, 0, 56)
    titleShadow.Position = UDim2.new(0, 2, 0, 102)

local function clearBody()
    for _, child in ipairs(pageBody:GetChildren()) do
        if not child:IsA("UIListLayout") then child:Destroy() end
    end
end

local function addInfo(text)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 0, 54)
    label.BackgroundColor3 = Color3.fromRGB(25, 28, 37)
    label.BackgroundTransparency = 0.12
    label.BorderSizePixel = 0
    label.Text = text
    label.TextColor3 = Color3.fromRGB(235, 238, 245)
    label.TextSize = 13
    label.Font = Enum.Font.Gotham
    label.TextWrapped = true
    label.TextXAlignment = Enum.TextXAlignment.Right
    label.ZIndex = 4
    label.Parent = pageBody
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 7)
end

local function addToggle(labelText)
    local state = false
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, 0, 0, 38)
    button.BackgroundColor3 = Color3.fromRGB(31, 37, 48)
    button.BorderSizePixel = 0
    button.TextColor3 = Color3.fromRGB(245, 245, 250)
    button.TextSize = 13
    button.Font = Enum.Font.GothamBold
    button.Text = labelText .. "  |  متوقف"
    button.TextXAlignment = Enum.TextXAlignment.Right
    button.ZIndex = 4
    button.Parent = pageBody
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 7)

    button.MouseButton1Click:Connect(function()
        state = not state
        button.Text = labelText .. (state and "  |  يعمل" or "  |  متوقف")
        button.BackgroundColor3 = state and Color3.fromRGB(20, 115, 75) or Color3.fromRGB(31, 37, 48)
    end)
end

local function showPage(item)
    pageTitle.Text = item[1]
    clearBody()
    addInfo(item[2] .. "\n" .. item[3])
    if item[1] == "الرئيسية" then
        addToggle("إظهار معلومات الواجهة")
        addToggle("تأثيرات الواجهة")
    elseif item[1] == "الأحداث" then
        addToggle("تنبيه الأحداث")
        addToggle("عرض قائمة الأحداث")
    elseif item[1] == "المزرعة" then
        addToggle("تنبيه الإنتاج")
        addToggle("عرض حالة المزرعة")
    else
        addToggle("تفعيل خيار الواجهة")
        addToggle("إظهار التفاصيل")
    end
end

for index, item in ipairs(pages) do
    local button = Instance.new("TextButton")
    button.LayoutOrder = index
    button.Size = UDim2.new(1, 0, 0, 29)
    button.BackgroundColor3 = Color3.fromRGB(28, 31, 41)
    button.BackgroundTransparency = 0.1
    button.BorderSizePixel = 0
    button.Text = item[1]
    button.TextColor3 = Color3.fromRGB(235, 238, 245)
    button.TextSize = 12
    button.Font = Enum.Font.GothamBold
    button.ZIndex = 3
    button.Parent = sidebar
    Instance.new("UICorner", button).CornerRadius = UDim.new(0, 6)

    button.MouseButton1Click:Connect(function()
        showPage(item)
        for _, sibling in ipairs(sidebar:GetChildren()) do
            if sibling:IsA("TextButton") then
                sibling.BackgroundColor3 = Color3.fromRGB(28, 31, 41)
            end
        end
        button.BackgroundColor3 = Color3.fromRGB(25, 105, 145)
    end)
end

-- سحب النافذة من الشريط العلوي
local dragging, dragStart, startPos
top.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

showPage(pages[1])

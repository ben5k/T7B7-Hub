			local mRes = customRequest({Url = FIREBASE_MUTE_URL, Method = "GET"})
			if mRes and mRes.StatusCode == 200 then MutedUsers = safeDecode(mRes.Body) or {} end

			-- 3. Fetch Broadcasts (جلب الإعلانات العلوية)
			local bRes = customRequest({Url = FIREBASE_BROADCAST_URL, Method = "GET"})
			if bRes and bRes.StatusCode == 200 then
				local data = safeDecode(bRes.Body)
				if data then
					for k, b in pairs(data) do
						if type(b) == "table" and b.text and not renderedBroadcasts[k] then
							renderedBroadcasts[k] = true
							if (os.time() - (b.time or 0)) < 30 then showTopBroadcast(b.sender, b.text) end
						end
					end
				end
			end

			-- 4. Fetch Polls (جلب التصويتات)
			local pRes = customRequest({Url = FIREBASE_POLL_URL, Method = "GET"})
			if pRes and pRes.StatusCode == 200 then
				local data = safeDecode(pRes.Body)
				if data and data.id ~= lastPollId then
					lastPollId = data.id
					if (os.time() - (data.time or 0)) < 60 then
						PollQuestion.Text = data.q
						PollFrame.Visible = true
						playSound("rbxassetid://1310682522", 1)
					end
				end
			end
			
			-- 5. Fetch Active Users (For Admin Tab)
			local uRes = customRequest({Url = FIREBASE_PRESENCE, Method = "GET"})
			if uRes and uRes.StatusCode == 200 then
				activeUsersList = safeDecode(uRes.Body) or {}
			end
		end)
		task.wait(5)
	end
end)



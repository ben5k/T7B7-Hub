-- دالة إرسال الطلبات الشاملة (تتوافق مع Roblox Studio ومختلف المنفذات Executor)
local function HttpRequest(options)
    local req = (syn and syn.request) or (http and http.request) or http_request or (fluxus and fluxus.request) or request
    if req then
        return req(options)
    elseif HttpService then
        if options.Method == "POST" then
            return { Body = HttpService:PostAsync(options.Url, options.Body, Enum.HttpContentType.ApplicationJson) }
        else
            return { Body = HttpService:GetAsync(options.Url) }
        end
    end
end


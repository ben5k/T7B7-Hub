    local function prepareRemoteMp3(url, index)
        local assetGetter = getcustomasset or getsynasset
        if type(writefile) ~= "function" or type(assetGetter) ~= "function" then
            return nil, "Delta لا يوفّر تحويل رابط MP3 إلى ملف محلي في هذه البيئة."
        end
        local localFile = string.format("KEON_Music_Cache_%02d.mp3", index)
        local hasFile = false
        if type(isfile) == "function" then
            pcall(function() hasFile = isfile(localFile) end)
        end
        if not hasFile then
            local response = customRequest({Url = url, Method = "GET"})
            local body = response and response.Body
            if not body or type(body) ~= "string" or #body < 1024 then
                return nil, "تعذّر تنزيل الأغنية من رابط الاستضافة."
            end
            local sample = string.lower(body:sub(1, 256))
            if sample:find("<html", 1, true) or sample:find("access denied", 1, true) then
                return nil, "رابط الأغنية أعاد صفحة ويب بدل ملف MP3."
            end
            local writeOk = pcall(function() writefile(localFile, body) end)
            if not writeOk then return nil, "فشل حفظ ملف الأغنية داخل Delta." end
        end
        local assetOk, assetPath = pcall(function() return assetGetter(localFile) end)
        if assetOk and type(assetPath) == "string" and assetPath ~= "" then
            return assetPath
        end
        return nil, "تعذّر تجهيز ملف الصوت محلياً."
    end


local function fetchScriptUsersOnly()
    pcall(function()
        local res = customRequest({Url = FIREBASE_USERS_URL, Method = "GET"})
        if res and res.StatusCode == 200 then
            local data = safeDecode(res.Body)
            if data then
                local activeUsers = {}
                local currentTime = os.time()
                
                for uid, uData in pairs(data) do
                    if type(uData) == "table" then
                        KEONProfile.profileByUserId[tostring(uData.userId or uid)] = uData
                        if uData.lastSeen and (currentTime - uData.lastSeen) < 35 then
                            table.insert(activeUsers, uData)
                        end
                    end
                end
                KEONProfile.refreshCountryTags()
                
                ChatHeaderBtn3.Text = "🟢 المتصلون (" .. #activeUsers .. ")"
                
                for _, child in ipairs(ChatOnlineContainer:GetChildren()) do
                    if not child:IsA("UIListLayout") then child:Destroy() end
                end
                
                for _, u in ipairs(activeUsers) do
                    local pFrame = Instance.new("Frame")
                    pFrame.Size = UDim2.new(1, 0, 0, 46)
                    pFrame.BackgroundColor3 = Color3.fromRGB(20, 29, 52)
                    pFrame.ZIndex = 3
                    pFrame.Parent = ChatOnlineContainer
                    Instance.new("UICorner", pFrame).CornerRadius = UDim.new(0, 9)

                    local pImg = Instance.new("ImageLabel")
                    pImg.Size = UDim2.new(0, 34, 0, 34)
                    pImg.Position = UDim2.new(1, -40, 0.5, -17)
                    pImg.BackgroundColor3 = Color3.fromRGB(31, 44, 73)
                    pImg.ZIndex = 4
                    pImg.Parent = pFrame
                    Instance.new("UICorner", pImg).CornerRadius = UDim.new(0, 17)
                    
                    loadAvatarThumbnail(u.userId, pImg)

                    local pNameLbl = Instance.new("TextLabel")
                    pNameLbl.Size = UDim2.new(1, -190, 1, 0)
                    pNameLbl.Position = UDim2.new(0, 140, 0, 0)
                    pNameLbl.BackgroundTransparency = 1
                    pNameLbl.Text = tostring(u.countryFlag or "🌐") .. "  ★ " .. (u.displayName or u.name or "لاعب")
                    pNameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                    pNameLbl.TextColor3 = currentAccentColor
                    pNameLbl.Font = Enum.Font.GothamBold
                    pNameLbl.TextSize = 13
                    pNameLbl.TextXAlignment = Enum.TextXAlignment.Right
                    pNameLbl.ZIndex = 4
                    pNameLbl.Parent = pFrame
                    table.insert(activeNameLabels, pNameLbl)

                    local viewBtn = Instance.new("TextButton")
                    viewBtn.Size = UDim2.new(0, 60, 0, 26)
                    viewBtn.Position = UDim2.new(0, 72, 0.5, -13)
                    viewBtn.BackgroundColor3 = currentAccentColor
                    viewBtn.Text = "عرض"
                    viewBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    viewBtn.Font = Enum.Font.GothamBold
                    viewBtn.TextSize = 11
                    viewBtn.ZIndex = 4
                    viewBtn.Parent = pFrame
                    Instance.new("UICorner", viewBtn).CornerRadius = UDim.new(0, 8)

                    local tpBtn = Instance.new("TextButton")
                    tpBtn.Size = UDim2.new(0, 60, 0, 26)
                    tpBtn.Position = UDim2.new(0, 6, 0.5, -13)
                    tpBtn.BackgroundColor3 = Color3.fromRGB(61, 112, 184)
                    tpBtn.Text = "انتقال ↗"
                    tpBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
                    tpBtn.Font = Enum.Font.GothamBold
                    tpBtn.TextSize = 11
                    tpBtn.ZIndex = 4
                    tpBtn.Parent = pFrame
                    Instance.new("UICorner", tpBtn).CornerRadius = UDim.new(0, 8)

                    viewBtn.MouseButton1Click:Connect(function()
                        playUiSound(SOUND_CLICK, 1, 0.35)
                        local targetPlr = Players:GetPlayerByUserId(u.userId)
                        if targetPlr and targetPlr.Character and targetPlr.Character:FindFirstChild("HumanoidRootPart") then
                            LocalPlayer.Character.HumanoidRootPart.CFrame = targetPlr.Character.HumanoidRootPart.CFrame + Vector3.new(0, 3, 0)
                        end
                    end)

                    tpBtn.MouseButton1Click:Connect(function()
                        playUiSound(SOUND_CLICK, 1, 0.35)
                        if u.placeId and u.jobId then
                            TeleportService:TeleportToPlaceInstance(u.placeId, u.jobId, LocalPlayer)
                        end
                    end)
                end
                ChatOnlineContainer.CanvasSize = UDim2.new(0, 0, 0, onlineLayout.AbsoluteContentSize.Y + 15)
            end
        end
    end)
end


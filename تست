	pcall(function() local s = Instance.new("Sound"); s.SoundId = id; s.Volume = vol or 0.6; s.Parent = SoundService; s.Ended:Connect(function() s:Destroy() end); s:Play(); task.delay(6, function() if s.Parent then s:Destroy() end end) end)
end

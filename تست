local function playUiSound(soundId, pitch, volume)
    task.spawn(function()
        pcall(function()
            local snd = Instance.new("Sound")
            snd.SoundId = soundId
            snd.Volume = volume or 0.35
            snd.Pitch = pitch or 1
            snd.Parent = SoundService
            if not snd.IsLoaded then snd.Loaded:Wait() end
            snd:Play()
            snd.Ended:Connect(function() snd:Destroy() end)
        end)
    end)
end


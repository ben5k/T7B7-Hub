    )

    SizeText.TextXAlignment = Enum.TextXAlignment.Left

    local function Resize(scale)

        local viewport = workspace.CurrentCamera.ViewportSize

        local width = math.floor(viewport.X * scale)
        local height = math.floor(viewport.Y * 0.76)

        width = math.clamp(width, 290, 760)
        height = math.clamp(height, 250, 490)

        Main.Size = UDim2.fromOffset(width, height)

        SizeText.Text = "الحجم الحالي: "
            .. math.floor(scale * 100) .. "%"

    end

    local Smaller = Create("TextButton", {
        Position = UDim2.fromOffset(12, 82),
        Size = UDim2.new(0.43, 0, 0, 38),
        BackgroundColor3 = PANEL,
        Text = "تصغير −",

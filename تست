                    local decoded = safeDecode(res.Body)
                    if type(decoded) == "table" then
                        for uid, record in pairs(decoded) do
                            if type(record) == "table" and tonumber(record.userId or uid) then
                                local speed = tonumber(record.eggSpeed)
                                local money = tonumber(record.eggMoney)

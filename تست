local PageFunctions = {
    ["الرئيسية"] = HomePage,
    ["سكربتات"] = ScriptsPage,
    ["اقتراحات"] = SuggestionsPage,
    ["موسيقي"] = MusicPage,
    ["مميزات"] = FeaturesPage,
    ["الإعدادات"] = SettingsPage
}

local function ShowPage(name)

    for pageName, button in pairs(Buttons) do

        local selected = pageName == name

        TweenService:Create(
            button,
            TweenInfo.new(0.15),
            {
                BackgroundColor3 = selected
                    and Color3.fromRGB(135, 20, 40)
                    or PANEL
            }
        ):Play()

        button.TextColor3 = selected and WHITE or GRAY

    end

    PageArea:ClearAllChildren()
    PageArea.CanvasPosition = Vector2.new(0, 0)

    local callback = PageFunctions[name]

    if callback then
        callback()
    end

end


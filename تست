local function createProStyleBtn(text, side)
    local sectionIcon = "✨"
    if string.find(text, "الرئيسية") then sectionIcon = "🎮"
    elseif string.find(text, "موعد") then sectionIcon = "⏰"
    elseif string.find(text, "سكربتات") then sectionIcon = "🧩"
    elseif string.find(text, "تسجيل") then sectionIcon = "🌍"
    elseif string.find(text, "توب") then sectionIcon = "🏆"
    elseif string.find(text, "الميديا") then sectionIcon = "🎵"
    elseif string.find(text, "تفعيلات") then sectionIcon = "⚡"
    elseif string.find(text, "اقتراحات") then sectionIcon = "💡"
    elseif string.find(text, "اسرق") then sectionIcon = "🥚"
    elseif string.find(text, "الإعدادات") then sectionIcon = "⚙️"
    elseif string.find(text, "الأدمن") then sectionIcon = "🛡️" end
    text = "✦ " .. sectionIcon .. " " .. text .. " ✦"
    local btn = Instance.new("TextButton")
    btn.Size = responsiveState.narrow and UDim2.new(0, 108, 0, 34) or UDim2.new(1, -4, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(8, 18, 36)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = responsiveState.narrow and 11.5 or 13
    btn.TextScaled = true
    btn.TextWrapped = false
    btn.TextTruncate = Enum.TextTruncate.AtEnd
    btn.AutoButtonColor = false
    btn.ClipsDescendants = false
    btn.ZIndex = responsiveState.narrow and 9 or 1
    local textConstraint = Instance.new("UITextSizeConstraint")
    textConstraint.MinTextSize = 10
    textConstraint.MaxTextSize = responsiveState.narrow and 12 or 13
    textConstraint.Parent = btn
    btn.Parent = (side == "left") and LeftWing or RightWing
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke")
    stroke.Color = currentAccentColor
    stroke.Thickness = 1.45
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Parent = btn

    table.insert(registeredWingStrokes, stroke)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(0, 88, 145)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(8, 18, 36)
        }):Play()
    end)
    return btn
end


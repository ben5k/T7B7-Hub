function Card:AddSlider(o)
	local min, max = o.Min or 0, o.Max or 100
	local value = math.clamp(o.Default or min, min, max)
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, Parent = self.Body }, { list(4) })
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = row })
	label({ Size = UDim2.new(1, -50, 1, 0), TextSize = 13, Weight = "Bold", Text = o.Title, Parent = top })
	local val = label({ Size = UDim2.fromOffset(46, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Weight = "Black", TextSize = 14, TextColor3 = Theme.Red, TextXAlignment = Enum.TextXAlignment.Right, Text = tostring(value), Parent = top })
	
	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), Parent = row })
	local track = new("Frame", { Size = UDim2.new(1, -10, 0, 12), Position = UDim2.new(0, 5, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.White, Parent = holder }, { corner(6), stroke(Theme.CardStroke, 2) })
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Red, BorderSizePixel = 0, Parent = track }, { corner(6) })
	local knob = new("Frame", { Size = UDim2.fromOffset(16, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Gold, ZIndex = 2, Parent = track }, { corner(6), stroke(Theme.CardStroke, 2) })
	local hit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = holder })

	local function render()
		local a = (max == min) and 0 or (value - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1)
		knob.Position = UDim2.fromScale(a, 0.5)
		val.Text = tostring(math.floor(value))
	end
	local dragging = false
	hit.InputBegan:Connect(function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			local function update(posX)
				local a = math.clamp((posX - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				value = min + a * (max - min)
				render(); fire(o.Callback, value)
			end
			update(i.Position.X)
		end
	end)
	UIS.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local a = math.clamp((i.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			value = min + a * (max - min)
			render(); fire(o.Callback, value)
		end
	end)
	UIS.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
	render()
end


--==================================================
-- BACKGROUND LOADER
--==================================================

local function LoadBackground()

    local req = request or http_request

    if not req and syn then
        req = syn.request
    end

    if not req or not writefile then
        return nil
    end

    local success, response = pcall(function()
        return req({
            Url = CONFIG.BackgroundURL,
            Method = "GET"
        })
    end)

    if not success or not response then
        return nil
    end

    if response.Success == false then
        return nil
    end

    if response.StatusCode and response.StatusCode ~= 200 then
        return nil
    end

    if not response.Body or #response.Body == 0 then
        return nil
    end

    local saved = pcall(function()
        writefile(CONFIG.ImageFile, response.Body)
    end)

    if not saved then
        return nil
    end

    local assetFunc = getcustomasset or getsynasset

    if not assetFunc then
        return nil
    end

    local loaded, asset = pcall(function()
        return assetFunc(CONFIG.ImageFile)
    end)

    if loaded then
        return asset
    end

    return nil
end


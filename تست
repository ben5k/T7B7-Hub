local function playMp3(url)
	Kaizo:Notify({ Title = "جاري التحميل", Text = "يتم تنزيل وتجهيز المقطع الصوتي...", Icon = "⏳" })
	task.spawn(function()
		local ok, data = pcall(function() return game:HttpGet(url) end)
		if ok and type(writefile) == "function" and type(getcustomasset) == "function" then
			writefile("KEON_Music.mp3", data)
			local asset = getcustomasset("KEON_Music.mp3")
			if activeSound then activeSound:Stop(); activeSound:Destroy() end
			local snd = Instance.new("Sound")
			snd.SoundId = asset; snd.Volume = mediaVolume / 10; snd.Parent = SoundService
			snd:Play(); activeSound = snd
			Kaizo:Notify({ Title = "تشغيل", Text = "الموسيقى تعمل الآن!", Icon = "▶" })
		else
			Kaizo:Notify({ Title = "خطأ", Text = "لم يتمكن المحاكي من تنزيل أو تشغيل الملف.", Icon = "❌" })
		end
	end)
end


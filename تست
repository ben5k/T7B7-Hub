local function makeQuickButton(label, color, order)
    local btn = create("TextButton", {
        LayoutOrder = order,
        BackgroundColor3 = COLORS.panel2,
        BorderSizePixel = 0,
        Text = label,
        TextColor3 = COLORS.text,
        Font = Enum.Font.GothamBold,
        TextSize = 10,

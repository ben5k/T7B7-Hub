local function sendMessageNow()
    if ChatInput.Text ~= "" then
        local msg = ChatInput.Text
        ChatInput.Text = ""
        
        task.spawn(function()
            local isMuted = false
            local muteReason = ""
            pcall(function()
                local res = customRequest({Url = FIREBASE_ADMIN_ACTIONS_URL, Method = "GET"})
                if res and res.StatusCode == 200 then
                    local data = safeDecode(res.Body)
                    if data and data.mutes and data.mutes[tostring(LocalPlayer.UserId)] then
                        local mInfo = data.mutes[tostring(LocalPlayer.UserId)]
                        if mInfo.muted then
                            isMuted = true
                            muteReason = mInfo.reason or "مخالفة القوانين"
                        end
                    end
                end
            end)

            if isMuted then
                addChatMessage("كـيـون 👑 (كتم الشات)", "❌ عذراً، لا يمكنك الكتابة لأنك مكتوم.\nالسبب: " .. muteReason, LocalPlayer.UserId, "muted_notice", false)
                return
            end

            pcall(function()
                customRequest({
                    Url = FIREBASE_CHAT_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
                        userId = LocalPlayer.UserId,
                        text = msg,
                        isSticker = false,
                        time = os.time()
                    })
                })
            end)
        end)
    end
end

SendBtn.MouseButton1Click:Connect(function() sendMessageNow() end)

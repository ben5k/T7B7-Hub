                end)
            end
        end
        MuteStatus.Text = "قائمة المكتومين: " .. tostring(count)
        MutedScroll.CanvasSize = UDim2.new(0, 0, 0, MutedLayout.AbsoluteContentSize.Y + 6)
    end

    MuteButton.MouseButton1Click:Connect(function()
        if LocalPlayer.Name ~= "Dms921" then return end
        local query = tostring(MuteSearch.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if query == "" then MuteStatus.Text = "اكتب اسم اللاعب أولاً" return end
        local foundId, foundName
        local numericId = tonumber(query)
        if numericId then
            foundId, foundName = tostring(math.floor(numericId)), query
        else
            local response = customRequest({Url = FIREBASE_PRESENCE_URL .. ".json", Method = "GET"})
            if response and response.StatusCode == 200 and response.Body and response.Body ~= "null" then
                local presence = HttpService:JSONDecode(response.Body)
                for _, user in pairs(presence) do
                    if type(user) == "table" then
                        local uname = tostring(user.name or "")
                        local dname = tostring(user.displayName or "")
                        if string.lower(uname) == string.lower(query) or string.lower(dname) == string.lower(query) then
                            foundId, foundName = tostring(user.userId or ""), uname
                            break
                        end
                    end
                end
            end
        end
        if not foundId or foundId == "" then MuteStatus.Text = "لم يتم العثور عليه في المتصلين" return end
        if foundId == tostring(LocalPlayer.UserId) then MuteStatus.Text = "لا يمكنك كتم نفسك" return end
        local ok = pcall(function()
            local res = customRequest({
                Url = FIREBASE_MUTED_URL .. "/" .. foundId .. ".json",
                Method = "PUT",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({userId = tonumber(foundId), name = foundName, by = "Dms921", time = os.time()})
            })
            if not res or (res.StatusCode ~= 200 and res.StatusCode ~= 204) then error("mute write failed") end
        end)
        MuteStatus.Text = ok and ("تم كتم " .. foundName) or "فشل الكتم؛ تحقق من Firebase"
        refreshMutedList()
    end)

    BroadcastSend.MouseButton1Click:Connect(function()
        if LocalPlayer.Name ~= "Dms921" then return end
        local message = tostring(BroadcastInput.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
        if message == "" then AdminStatus.Text = "اكتب رسالة أولاً" return end
        if #message > 220 then AdminStatus.Text = "الحد 220 حرف" return end
        BroadcastSend.Active = false
        BroadcastSend.Text = "جارٍ..."
        local payload = {id = tostring(os.time()) .. "_" .. tostring(math.random(100000,999999)), sender = "Dms921", userId = LocalPlayer.UserId, text = message, time = os.time()}
        local ok, response = pcall(function()
            return customRequest({Url = FIREBASE_BROADCAST_URL, Method = "PUT", Headers = { ["Content-Type"] = "application/json" }, Body = HttpService:JSONEncode(payload)})
        end)
        BroadcastSend.Active = true
        BroadcastSend.Text = "إرسال للجميع"
        AdminStatus.Text = (ok and response and (response.StatusCode == 200 or response.StatusCode == 204)) and "تم الإرسال ✓" or "فشل الإرسال"
        if ok and response and (response.StatusCode == 200 or response.StatusCode == 204) then BroadcastInput.Text = "" end
    end)
    task.spawn(function()

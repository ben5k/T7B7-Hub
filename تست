local function getViewportSize()
    local camera = workspace.CurrentCamera
    if camera then return camera.ViewportSize end
    return Vector2.new(1280, 720)
end

applyResponsiveMain = function()
    local viewport = getViewportSize()
    local narrow = viewport.X < 650 or viewport.Y < 430
    responsiveState.narrow = narrow

    if narrow then
        local width = math.max(300, math.floor(viewport.X - 12))
        local height = math.max(300, math.min(560, math.floor(viewport.Y - 16)))
        responsiveState.mainSize = UDim2.new(0, width, 0, height)
        responsiveState.mainPosition = UDim2.new(0, math.max(0, math.floor((viewport.X - width) / 2)), 0, math.max(0, math.floor((viewport.Y - height) / 2)))

        MainFrame.Size = responsiveState.mainSize
        MainFrame.Position = responsiveState.mainPosition
        CenterBox.Size = UDim2.new(1, 0, 1, 0)
        CenterBox.Position = UDim2.new(0, 0, 0, 0)
        CenterGlow.Size = UDim2.new(1, 0, 1, 8)
        CenterGlow.Position = UDim2.new(0, 0, 0, -4)

        LeftWing.Size = UDim2.new(1, -12, 0, 36)
        LeftWing.Position = UDim2.new(0, 6, 0, 48)
        RightWing.Size = UDim2.new(1, -12, 0, 36)
        RightWing.Position = UDim2.new(0, 6, 0, 88)

function KEONProfile.formatPlayTime(seconds)
    seconds = math.max(0, math.floor(tonumber(seconds) or 0))
    local hours = math.floor(seconds / 3600)
    local minutes = math.floor((seconds % 3600) / 60)
    local secs = seconds % 60
    if hours > 0 then return string.format("%dس %02dد", hours, minutes) end
    if minutes > 0 then return string.format("%dد %02dث", minutes, secs) end
    return string.format("%dث", secs)
end

-- اختصار الأرقام الكبيرة في التوب: 950، 1K، 1.2M، 3B، 1T
function KEONProfile.formatCompactNumber(value)
    value = tonumber(value) or 0
    local absValue = math.abs(value)
    local function compact(divisor, suffix)
        local n = value / divisor
        local formatted = string.format(absValue / divisor >= 100 and "%.0f" or (absValue / divisor >= 10 and "%.1f" or "%.2f"), n)
        if formatted:find("%.") then
            formatted = formatted:gsub("0+$", ""):gsub("%.$", "")
        end
        return formatted .. suffix
    end
    if absValue >= 1e12 then return compact(1e12, "T") end
    if absValue >= 1e9 then return compact(1e9, "B") end
    if absValue >= 1e6 then return compact(1e6, "M") end
    if absValue >= 1e3 then return compact(1e3, "K") end
    return tostring(math.floor(value))
end


local function register(card, row, o) table.insert(card.Elements, { Frame = row, Text = string.lower((o.Title or o.Text or "") .. " " .. (o.Description or "")) }) end
local function textBlock(parent, o, size)
	local f = new("Frame", { BackgroundTransparency = 1, Size = size, AutomaticSize = Y, Parent = parent }, { list(2) })
	if o.Title then local t = label({ TextSize = 13, Weight = "ExtraBold", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, TextColor3 = o.TitleColor or Theme.Text, LayoutOrder = 1, Parent = f }); bind(t, o.Title) end
	if o.Description then local d = label({ Weight = "Medium", TextSize = 11, TextColor3 = Theme.Muted, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, LayoutOrder = 2, Parent = f }); bind(d, o.Description) end
	return f
end
local function fieldBox(parent, h) return new("Frame", { Size = UDim2.new(1, 0, 0, h or 38), BackgroundColor3 = Theme.Field, Parent = parent }, { corner(9), stroke(Theme.CardStroke, 2) }) end

function Card:AddToggle(o)
	local state, hasKey = o.Default == true, o.Keybind == true
	local rightW = hasKey and 122 or 54
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Y, Parent = self.Body })
	textBlock(row, o, UDim2.new(1, -(rightW + 6), 0, 0))

	local sw = new("TextButton", { Size = UDim2.fromOffset(50, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), BackgroundColor3 = state and Theme.Green or Theme.Off, Text = "", AutoButtonColor = false, Parent = row }, { corner(13), stroke(Theme.CardStroke, 2) })
	local knob = new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0, 0.5), Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Theme.White, Parent = sw }, { corner(10), stroke(Theme.CardStroke, 1.5) })

	local obj = {}
	function obj.Set(v, silent)
		state = v and true or false
		tween(sw, 0.18, { BackgroundColor3 = state and Theme.Green or Theme.Off }):Play()
		tween(knob, 0.2, { Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, Enum.EasingStyle.Back):Play()
		if not silent then fire(o.Callback, state) end
	end
	function obj.Get() return state end
	sw.MouseButton1Click:Connect(function() obj.Set(not state) end); pressFx(sw, 0.06)
	if hasKey then
		local kb = new("TextButton", { Size = UDim2.fromOffset(62, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -58, 0, 2), BackgroundColor3 = Theme.Field, Text = "None", Font = FONT.ExtraBold, TextSize = 11, TextColor3 = Theme.Text, AutoButtonColor = false, Parent = row }, { corner(8), stroke(Theme.CardStroke, 2) })
		local listening, bound = false, nil
		kb.MouseButton1Click:Connect(function() click(); listening = true; kb.Text = "..." end)
		table.insert(LangRefreshers, function() if not listening and not bound then kb.Text = tr("None") end end)
		connect(UIS.InputBegan, function(input, gp)
			if listening and input.UserInputType == Enum.UserInputType.Keyboard then
				listening = false
				if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.Backspace then bound, kb.Text = nil, tr("None") else bound, kb.Text = input.KeyCode, input.KeyCode.Name end
				return
			end
			if bound and not gp and input.KeyCode == bound then obj.Set(not state) end
		end)
	end
	register(self, row, o); return obj
end

function Card:AddDropdown(o)
	local multi, options, selected, current = o.Multi == true, o.Options or {}, {}, o.Default
	if multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do selected[v] = true end end

	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, Parent = self.Body }, { list(6) })
	textBlock(row, o, UDim2.new(1, 0, 0, 0)).LayoutOrder = 1
	local box = fieldBox(row, 38); box.LayoutOrder = 2
	local btn = new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", AutoButtonColor = false, Parent = box })
	local txt = label({ Size = UDim2.new(1, -52, 1, 0), Position = UDim2.fromOffset(12, 0), TextSize = 13, Weight = "ExtraBold", TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn })
	local arrow = new("Frame", { Size = UDim2.fromOffset(28, 28), Position = UDim2.new(1, -34, 0.5, -14), BackgroundColor3 = Theme.Red, Parent = btn }, { corner(7), stroke(Theme.CardStroke, 1.5) })
	local arrowLbl = label({ Size = UDim2.fromScale(1, 1), Text = "▾", TextSize = 15, Weight = "Heavy", TextColor3 = Theme.White, TextXAlignment = Enum.TextXAlignment.Center, Parent = arrow })
	local drop = new("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, BackgroundColor3 = Theme.Field, Visible = false, LayoutOrder = 3, Parent = row }, { corner(9), stroke(Theme.CardStroke, 2), list(2), pad(4, 4, 4, 4) })

	local optBtns = {}
	local function display()
		if multi then local t = {}; for _, opt in ipairs(options) do if selected[opt] then t[#t + 1] = tr(opt) end end; return #t == 0 and tr("None") or table.concat(t, ", ") end
		return current and tr(current) or tr("None")
	end
	local function value()
		if multi then local t = {}; for _, opt in ipairs(options) do if selected[opt] then t[#t + 1] = opt end end; return t end
		return current
	end
	local function refresh()
		txt.Text = display()
		for opt, o2 in pairs(optBtns) do
			local on = multi and selected[opt] or (not multi and current == opt)
			o2.Btn.BackgroundTransparency = on and 0 or 1; o2.Check.Visible = on and true or false
		end
	end
	table.insert(LangRefreshers, refresh)

	for i, opt in ipairs(options) do
		local b = new("TextButton", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Theme.Content, BackgroundTransparency = 1, Text = "", AutoButtonColor = false, LayoutOrder = i, Parent = drop }, { corner(7) })
		local ol = label({ Size = UDim2.new(1, -34, 1, 0), Position = UDim2.fromOffset(10, 0), TextSize = 12, Weight = "Bold", Parent = b }); bind(ol, opt)
		local check = label({ Size = UDim2.fromOffset(22, 30), Position = UDim2.new(1, -26, 0, 0), Text = "✓", TextSize = 14, Weight = "Heavy", TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Center, Visible = false, Parent = b })
		optBtns[opt] = { Btn = b, Check = check }
		b.MouseEnter:Connect(function() if b.BackgroundTransparency == 1 then tween(b, 0.1, { BackgroundTransparency = 0.6 }):Play() end end)
		b.MouseLeave:Connect(function() local on = multi and selected[opt] or (not multi and current == opt); tween(b, 0.1, { BackgroundTransparency = on and 0 or 1 }):Play() end)
		b.MouseButton1Click:Connect(function() click(); if multi then selected[opt] = not selected[opt] or nil else current = opt; drop.Visible = false; arrowLbl.Text = "▾" end; refresh(); fire(o.Callback, value()) end)
	end
	btn.MouseButton1Click:Connect(function() click(); drop.Visible = not drop.Visible; arrowLbl.Text = drop.Visible and "▴" or "▾" end)
	refresh()

	local obj = {}
	function obj.Get() return value() end
	function obj.Set(v) if multi then selected = {}; for _, x in ipairs(v or {}) do selected[x] = true end else current = v end; refresh(); fire(o.Callback, value()) end
	register(self, row, o); return obj
end

function Card:AddSlider(o)
	local min, max, inc = o.Min or 0, o.Max or 100, o.Increment or 1
	local value = math.clamp(o.Default or min, min, max)
	local page = self.Page
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, Parent = self.Body }, { list(4) })
	local top = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), LayoutOrder = 1, Parent = row })
	local t = label({ Size = UDim2.new(1, -50, 1, 0), TextSize = 13, Weight = "ExtraBold", Parent = top }); bind(t, o.Title)
	local val = label({ Size = UDim2.fromOffset(46, 18), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Weight = "Heavy", TextSize = 14, TextColor3 = Theme.Red, TextXAlignment = Enum.TextXAlignment.Right, Parent = top })
	if o.Description then local d = label({ Weight = "Medium", TextSize = 11, TextColor3 = Theme.Muted, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, LayoutOrder = 2, Parent = row }); bind(d, o.Description) end

	local holder = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 28), LayoutOrder = 3, Parent = row })
	local track = new("Frame", { Size = UDim2.new(1, -10, 0, 12), Position = UDim2.new(0, 5, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), BackgroundColor3 = Theme.White, Parent = holder }, { corner(6), stroke(Theme.CardStroke, 2) })
	local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Theme.Red, BorderSizePixel = 0, Parent = track }, { corner(6) })
	local knob = new("Frame", { Size = UDim2.fromOffset(16, 24), AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), BackgroundColor3 = Theme.Gold, ZIndex = 2, Parent = track }, { corner(6), stroke(Theme.CardStroke, 2) })
	local hit = new("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", ZIndex = 3, Parent = holder })

	local function render()
		local a = (max == min) and 0 or (value - min) / (max - min)
		fill.Size = UDim2.fromScale(a, 1); knob.Position = UDim2.fromScale(a, 0.5); val.Text = tostring(value)
	end
	local function setFromX(x, silent)
		local a = math.clamp((x - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
		local v = min + a * (max - min); v = math.clamp(math.floor((v - min) / inc + 0.5) * inc + min, min, max)
		if v ~= value then value = v; render(); if not silent then fire(o.Callback, value) end end
	end

	local dragging = false
	hit.InputBegan:Connect(function(i) if isPointer(i) then dragging = true; page.ScrollingEnabled = false; tween(knob, 0.1, { Size = UDim2.fromOffset(20, 28) }):Play(); setFromX(i.Position.X) end end)
	connect(UIS.InputChanged, function(i) if dragging and isMove(i) then setFromX(i.Position.X) end end)
	connect(UIS.InputEnded, function(i) if dragging and isPointer(i) then dragging = false; page.ScrollingEnabled = true; tween(knob, 0.15, { Size = UDim2.fromOffset(16, 24) }, Enum.EasingStyle.Back):Play() end end)
	render()

	local obj = {}
	function obj.Get() return value end
	function obj.Set(v) value = math.clamp(v, min, max); render(); fire(o.Callback, value) end
	register(self, row, o); return obj
end


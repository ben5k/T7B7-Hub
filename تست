-- دورة المزامنة والريست العالمي كل 30 دقيقة (1800 ثانية)
Ben.load.set(0.9, "الاتصال بالشات العام…")
task.spawn(function()
    local INTERVAL = 1800
    local lastCycle = math.floor(os.time() / INTERVAL)
    local useQuery = true
    local fails = 0
    while ScreenGui and ScreenGui.Parent do
        refreshMutedCache()
        local now = os.time()
        local currentCycle = math.floor(now / INTERVAL)
        local remaining = INTERVAL - (now % INTERVAL)
        local mins = math.floor(remaining / 60)
        local secs = remaining % 60

        if ChatTimerLbl then
            if fails >= 3 then
                ChatTimerLbl.Text = "⚠️ انقطاع الاتصال"
                ChatTimerLbl.TextColor3 = Color3.fromRGB(255, 120, 120)
            else
                ChatTimerLbl.Text = string.format("⏱️ %02d:%02d", mins, secs)
                ChatTimerLbl.TextColor3 = (remaining <= 60) and Color3.fromRGB(255, 180, 90) or Color3.fromRGB(150, 255, 150)
            end
        end

        if currentCycle ~= lastCycle then
            lastCycle = currentCycle
            renderedMsgs = {}
            Ben.msgFrames = {}
            for _, child in ipairs(ChatScroll:GetChildren()) do
                if child:IsA("Frame") then child:Destroy() end
            end
            addChatMessage("sys_reset", 0, "النظام", "🔄 تم إعادة تصفير الشات لمرور 30 دقيقة.")
        end

        pcall(function()
            local url = useQuery and (FIREBASE_CHAT_URL .. "?orderBy=%22%24key%22&limitToLast=80") or FIREBASE_CHAT_URL
            local res = customRequest({Url = url, Method = "GET"})
            if res and res.StatusCode == 200 then
                fails = 0
                if res.Body ~= "" and res.Body ~= "null" then
                    local data = HttpService:JSONDecode(res.Body)
                    if type(data) == "table" then
                        local list = {}
                        for key, msg in pairs(data) do
                            if type(msg) == "table" and type(msg.time) == "number" and math.floor(msg.time / INTERVAL) == currentCycle then
                                list[#list + 1] = {key = key, msg = msg}
                            end
                        end
                        table.sort(list, function(a, b)
                            if a.msg.time ~= b.msg.time then return a.msg.time < b.msg.time end
                            return tostring(a.key) < tostring(b.key)
                        end)
                        for _, it in ipairs(list) do
                            local incomingText = tostring(it.msg.text or "")
                            local blockedIncoming = checkBadContent(incomingText)
                            if not blockedIncoming then
                                addChatMessage(it.key, tonumber(it.msg.userId) or 0, tostring(it.msg.sender or "مجهول"), incomingText)
                            end
                        end
                    end
                end
                Ben.synced = true
            elseif useQuery and res and res.StatusCode == 400 then
                useQuery = false
            else
                fails = fails + 1
            end
        end)

        task.wait(ChatWindow.Visible and 2 or 5)
    end
end)


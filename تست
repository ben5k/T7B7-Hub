    tiles.BackgroundTransparency = 1
    tiles.ClipsDescendants = true
    tiles.ZIndex = 5
    tiles.Parent = ground
    for row = 0, 1 do
        for col = -1, 9 do
            local b = Instance.new("Frame")
            b.Size = UDim2.new(0, 37, 0, 14)
            b.Position = UDim2.new(0, col * 40 + (row == 1 and 20 or 0) + 1, 0, 3 + row * 16)
            b.BackgroundColor3 = (row == 0) and Color3.fromRGB(228, 124, 56) or Color3.fromRGB(214, 108, 44)
            b.BorderSizePixel = 0
            b.ZIndex = 6
            b.Parent = tiles
        end
    end

    -- بريق صغير في السماء
    local sparks = {}
    for i = 1, 10 do
        local d = circle((i * 83) % 370 + 12, (i * 47) % 150 + 10, (i % 3 == 0) and 4 or 3, Color3.fromRGB(190, 240, 255), 2)
        sparks[i] = {obj = d, ph = i * 0.9}
    end

    -- صندوق الـ ؟
    local qb = Instance.new("Frame")
    qb.Size = UDim2.new(0, 28, 0, 28)
    qb.Position = UDim2.new(0, 24, 0, 30)

local Tab, Card = {}, {}; Tab.__index, Card.__index = Tab, Card
local function selectTab(tab)
	currentTab = tab
	for _, t in ipairs(Kaizo.Tabs) do
		local on = (t == tab)
		t.Page.Visible = on
		t.Selected = on
		t.Stroke.Enabled = on
		tween(t.Button, 0.18, { BackgroundColor3 = on and Theme.TabActive or Theme.Side, BackgroundTransparency = on and 0.2 or 1 }):Play()
		t.NameLabel.TextColor3 = on and Theme.White or Theme.SideText
	end
	tab.Page.Position = UDim2.fromOffset(0, 16)
	tween(tab.Page, 0.3, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint):Play()
	refreshHeader()
end


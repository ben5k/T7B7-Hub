local function corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius or 8)
    c.Parent = obj
    return c
end

local function stroke(obj, color, transparency)
    local s = Instance.new("UIStroke")
    s.Color = color or RED
    s.Thickness = 1
    s.Transparency = transparency or 0.45
    s.Parent = obj
    return s
end

local function label(parent, text, size, color, position, dimensions, bold)
    local l = Instance.new("TextLabel")
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextSize = size or 13
    l.TextColor3 = color or WHITE
    l.Font = bold and Enum.Font.GothamBold or Enum.Font.Gotham
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Center
    l.Position = position or UDim2.new()
    l.Size = dimensions or UDim2.new(1, 0, 0, 25)
    l.Parent = parent
    return l
end

local function button(parent, text, position, dimensions, callback)
    local b = Instance.new("TextButton")
    b.AutoButtonColor = false
    b.Text = text
    b.TextColor3 = WHITE
    b.TextSize = 12
    b.Font = Enum.Font.GothamBold
    b.BackgroundColor3 = PANEL
    b.Position = position
    b.Size = dimensions
    b.Parent = parent
    corner(b, 7)
    stroke(b, RED, 0.55)

    b.MouseButton1Click:Connect(function()
        TweenService:Create(b, TweenInfo.new(0.12), {
            BackgroundColor3 = Color3.fromRGB(55, 24, 29)
        }):Play()
        task.delay(0.15, function()
            if b.Parent then
                TweenService:Create(b, TweenInfo.new(0.15), {
                    BackgroundColor3 = PANEL
                }):Play()
            end
        end)
        if callback then callback() end
    end)
    return b
end

local function card(parent, position, dimensions)
    local f = Instance.new("Frame")
    f.BackgroundColor3 = PANEL
    f.BackgroundTransparency = 0.08
    f.Position = position
    f.Size = dimensions
    f.Parent = parent
    corner(f, 9)
    stroke(f, RED, 0.72)
    return f
end

local function copyText(value)
    local copied = false
    pcall(function()
        if setclipboard then
            setclipboard(value)
            copied = true
        end
    end)
    return copied
end


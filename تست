local lastChatSentAt = 0
local function sendChatMessage()
	local msg = ChatInputBox.Text
	ChatInputBox.Text = ""
	if msg == "" or #msg > 250 then return end
	if os.clock() - lastChatSentAt < 2 then Kaizo:Notify({ Title = "Chat", Text = "Wait 2 seconds." }); return end
	lastChatSentAt = os.clock()

	task.spawn(function()
		local isMuted = false
		pcall(function()
			local res = customRequest({Url = FIREBASE_ADMIN_ACTIONS_URL, Method = "GET"})
			if res and res.StatusCode == 200 then
				local data = safeDecode(res.Body)
				if data and data.mutes and data.mutes[tostring(LocalPlayer.UserId)] and data.mutes[tostring(LocalPlayer.UserId)].muted then isMuted = true end
			end
		end)
		if isMuted then Kaizo:Notify({ Title = "Muted", Text = "You are muted." }); return end
		pcall(function()
			customRequest({
				Url = FIREBASE_CHAT_URL, Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = HttpService:JSONEncode({ sender = LocalPlayer.DisplayName, userId = LocalPlayer.UserId, text = msg, countryFlag = KEONProfile.selectedCountryFlag, time = os.time() })
			})
		end)
	end)
end


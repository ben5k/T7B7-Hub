local function showPrivateScriptUserBubble(userId, text)
    local targetPlr = Players:GetPlayerByUserId(userId)
    if not targetPlr or not targetPlr.Character then return end
    local head = targetPlr.Character:FindFirstChild("Head")
    if not head then return end

    if head:FindFirstChild("KEONScriptBubble") then head.KEONScriptBubble:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "KEONScriptBubble"
    bb.Size = UDim2.new(0, 220, 0, 50)
    bb.StudsOffset = Vector3.new(0, 2.5, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local bubbleFrame = Instance.new("Frame")
    bubbleFrame.Size = UDim2.new(1, 0, 1, 0)
    bubbleFrame.BackgroundColor3 = Color3.fromRGB(15, 22, 42)
    bubbleFrame.BackgroundTransparency = 0
    bubbleFrame.Parent = bb
    Instance.new("UICorner", bubbleFrame).CornerRadius = UDim.new(0, 11)

    local bStroke = Instance.new("UIStroke")
    bStroke.Color = currentAccentColor
    bStroke.Thickness = 2
    bStroke.Parent = bubbleFrame

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 1, -10)
    lbl.Position = UDim2.new(0, 5, 0, 5)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 13
    lbl.TextWrapped = true
    lbl.Parent = bubbleFrame

    task.delay(6, function()
        if bb and bb.Parent then bb:Destroy() end
    end)
end


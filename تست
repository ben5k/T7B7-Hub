local lastChatSentAt = 0
local blockedChatTerms = {
    "كس", "كسم", "شرموط", "شرموطة", "قحبة", "منيوك", "يلعن", "fuck", "shit", "bitch", "asshole"
}

local function normalizeChatText(value)
    value = string.lower(tostring(value or ""))
    value = value:gsub("[أإآا]", "ا"):gsub("ى", "ي"):gsub("ة", "ه")
    value = value:gsub("[%p%c%s]+", "")
    return value
end

local function sendMessageNow()
    if ChatInput.Text ~= "" then
        local msg = ChatInput.Text
        ChatInput.Text = ""
        if #msg > 250 then
            addChatMessage("KEON • الحماية", "⚠️ الرسالة طويلة جداً. الحد الأقصى 250 حرفاً.", LocalPlayer.UserId, "chat_guard_length", false)
            return
        end
        if os.clock() - lastChatSentAt < 2 then
            addChatMessage("KEON • الحماية", "⏳ انتظر ثانيتين قبل إرسال رسالة أخرى لتقليل السبام.", LocalPlayer.UserId, "chat_guard_rate", false)
            return
        end
        local normalizedMessage = normalizeChatText(msg)
        for _, term in ipairs(blockedChatTerms) do
            if normalizedMessage:find(normalizeChatText(term), 1, true) then
                addChatMessage("KEON • الحماية", "🛡️ تم منع الرسالة لأنها قد تحتوي على إساءة. رجاءً احترم الجميع.", LocalPlayer.UserId, "chat_guard_toxic", false)
                return
            end
        end
        lastChatSentAt = os.clock()
        
        task.spawn(function()
            local isMuted = false
            local muteReason = ""
            pcall(function()
                local res = customRequest({Url = FIREBASE_ADMIN_ACTIONS_URL, Method = "GET"})
                if res and res.StatusCode == 200 then
                    local data = safeDecode(res.Body)
                    if data and data.mutes and data.mutes[tostring(LocalPlayer.UserId)] then
                        local mInfo = data.mutes[tostring(LocalPlayer.UserId)]
                        if mInfo.muted then
                            isMuted = true
                            muteReason = mInfo.reason or "مخالفة القوانين"
                        end
                    end
                end
            end)

            if isMuted then
                addChatMessage("كـيـون 👑 (كتم الشات)", "❌ عذراً، لا يمكنك الكتابة لأنك مكتوم.\nالسبب: " .. muteReason, LocalPlayer.UserId, "muted_notice", false)
                return
            end

            pcall(function()
                customRequest({
                    Url = FIREBASE_CHAT_URL,
                    Method = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body = HttpService:JSONEncode({
                        sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
                        userId = LocalPlayer.UserId,
                        text = msg,
                        countryFlag = KEONProfile.selectedCountryFlag,
                        countryName = KEONProfile.selectedCountryName,
                        countryCode = KEONProfile.selectedCountryCode,
                        isSticker = false,
                        time = os.time()
                    })
                })
            end)
        end)
    end
end


        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.5, 0.45),
        NumberSequenceKeypoint.new(1, 1)
    })
    sheenGrad.Parent = sheen

    local head = circle(0, 0, 16, WHITE, 11, BarBg)
    head.AnchorPoint = Vector2.new(0.5, 0.5)
    head.Position = UDim2.new(0, 0, 0.5, 0)
    head.Visible = false
    local headStroke = Instance.new("UIStroke")
    headStroke.Color = Color3.fromRGB(255, 150, 30)
    headStroke.Thickness = 3
    headStroke.Parent = head

    -- فطر بكسل يركض على الشريط
    local runner = Instance.new("Frame")
    runner.Size = UDim2.new(0, 33, 0, 30)
    runner.Position = UDim2.new(0, 14, 0, 230)
    runner.BackgroundTransparency = 1
    runner.ZIndex = 8
    runner.Parent = LoadFrame
    local rows = {
        "...DDDDD...",
        "..DRRWWRD..",
        ".DRWWWRRWD.",
        "DRRWWWRRWWD",
        "DRRRWRRRWRD",
        "DRRRRRRRRRD",
        ".DDDDDDDDD.",
        "..DSDSDSD..",
        "..DSSSSSD..",
        "...DDDDD..."
    }
    local palette = {
        D = Color3.fromRGB(50, 28, 28),
        R = Color3.fromRGB(229, 37, 33),
        W = Color3.fromRGB(255, 255, 255),
        S = Color3.fromRGB(252, 226, 184)
    }
    for ry, row in ipairs(rows) do
        for rx = 1, #row do
            local col = palette[row:sub(rx, rx)]
            if col then
                local px = Instance.new("Frame")
                px.Size = UDim2.new(0, 3, 0, 3)
                px.Position = UDim2.new(0, (rx - 1) * 3, 0, (ry - 1) * 3)
                px.BackgroundColor3 = col
                px.BorderSizePixel = 0
                px.ZIndex = 9
                px.Parent = runner
            end
        end
    end

    -- وميض عند اكتمال التحميل
    local flash = Instance.new("Frame")
    flash.Size = UDim2.new(1, 0, 1, 0)
    flash.BackgroundColor3 = WHITE
    flash.BackgroundTransparency = 1
    flash.BorderSizePixel = 0
    flash.ZIndex = 20
    flash.Parent = LoadFrame
    Instance.new("UICorner", flash).CornerRadius = UDim.new(0, 14)

    -- حلقة الحركة الواحدة
    local t0 = os.clock()
    local finished = false
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not LoadingGui.Parent then
            conn:Disconnect()
            return
        end
        local t = os.clock() - t0

        -- تقدّم تلقائي ناعم أثناء بناء الواجهة (لا ينزل أبداً، ويكمل الشريط الحقيقي بعده)
        local p = BarFill.Size.X.Scale
        local fake = math.min(0.9, 1 - math.exp(-t * 0.8))
        if p < fake then
            BarFill.Size = UDim2.new(fake, 0, 1, 0)
            p = fake
        end

        for _, c in ipairs(clouds) do
            local x = ((c.phase * 520 + t * c.speed) % 520) - 100
            c.obj.Position = UDim2.new(0, x, 0, c.y)
        end
        sunGlow.BackgroundTransparency = 0.55 + 0.2 * math.sin(t * 2)
        local gs = 74 + 6 * math.sin(t * 2)
        sunGlow.Size = UDim2.new(0, gs, 0, gs)
        sunGlow.Position = UDim2.new(0, 355 - gs / 2, 0, 51 - gs / 2)
        for _, s in ipairs(sparks) do
            s.obj.BackgroundTransparency = 0.25 + 0.7 * (0.5 + 0.5 * math.sin(t * 2.5 + s.ph))
        end

        qb.Position = UDim2.new(0, 24, 0, 30 + math.sin(t * 3) * 2.5)
        ring.Position = UDim2.new(0, 166, 0, 12 + math.sin(t * 2.4) * 1.5)

        PctLbl.Text = tostring(math.floor(p * 100 + 0.5)) .. "%"
        local hop = (p < 0.999) and (-math.abs(math.sin(t * 9)) * 7) or 0
        runner.Position = UDim2.new(0, 30 + p * 340 - 16, 0, 232 + hop)
        head.Visible = p > 0.01 and p < 0.995
        head.Position = UDim2.new(p, 0, 0.5, 0)
        sheen.Position = UDim2.new(0, -44 + ((t / 1.0) % 1) * 400, 0, 0)

        if not finished and p >= 0.999 then
            finished = true
            flash.BackgroundTransparency = 0.6
            TweenService:Create(flash, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {BackgroundTransparency = 1}):Play()
            loadStroke.Thickness = 5.5
            TweenService:Create(loadStroke, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Thickness = 3.5}):Play()
        end
    end)
end)

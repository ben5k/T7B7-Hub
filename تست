task.spawn(function()
    -- Local backup first, so a temporary network failure never wipes a player's saved time.
    pcall(function()
        if readfile and isfile and isfile(KEONProfile.LOCAL_USAGE_FILE) then
            local localRecord = safeDecode(readfile(KEONProfile.LOCAL_USAGE_FILE))
            if type(localRecord) == "table" then
                KEONProfile.savedUsageSeconds = math.max(0, tonumber(localRecord.totalSeconds) or 0)
            end
        end
    end)
    pcall(function()
        local res = customRequest({Url = FIREBASE_BASE_URL .. "/usage_stats/" .. tostring(LocalPlayer.UserId) .. ".json", Method = "GET"})
        if res and res.StatusCode == 200 then
            KEONProfile.usageStoreWritable = true
            local data = safeDecode(res.Body)
            if type(data) == "table" then
                KEONProfile.savedUsageSeconds = math.max(KEONProfile.savedUsageSeconds, tonumber(data.totalSeconds) or 0)
            end
        end
    end)
    KEONProfile.usageDataLoaded = true
end)


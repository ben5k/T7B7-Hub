            local TPS = game:GetService("TeleportService")
            local Api = "https://games.roblox.com/v1/games/"
            local _place = game.PlaceId
            
            task.spawn(function()
                local cursor = ""
                local targetServerId = nil
                
                repeat
                    local url = Api .. tostring(_place) .. "/servers/Public?sortOrder=Asc&limit=100"
                    if cursor ~= "" then
                        url = url .. "&cursor=" .. cursor
                    end
                    
                    local success, raw = pcall(function() return game:HttpGet(url) end)
                    if success and raw then
                        local decoded = Http:JSONDecode(raw)
                        if decoded and decoded.data then
                            for _, s in ipairs(decoded.data) do
                                if s.playing and (s.playing == 1 or s.playing == 2) and s.id ~= game.JobId then
                                    targetServerId = s.id
                                    break
                                end
                            end
                            cursor = decoded.nextPageCursor
                        else
                            break
                        end
                    else
                        break
                    end
                    task.wait(0.2)
                until targetServerId or not cursor or cursor == ""
                
                if targetServerId then
                    TPS:TeleportToPlaceInstance(_place, targetServerId, LocalPlayer)
                else
                    TPS:Teleport(_place, LocalPlayer)
                end
            end)
        end)

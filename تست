task.spawn(function()
    while true do
        pcall(function()
            local now = os.time()
            local dateTable = os.date("!*t", now + 10800) -- UTC+3
            local wday = dateTable.wday
            local daysUntilSaturday = (7 - wday) % 7
            if daysUntilSaturday == 0 then
                if dateTable.hour >= 18 then
                    daysUntilSaturday = 7
                end
            end
            
            local targetDaySecs = (dateTable.hour * 3600) + (dateTable.min * 60) + dateTable.sec
            local targetSecsToday = 18 * 3600
            local diffSecs = 0
            if daysUntilSaturday > 0 then
                diffSecs = (daysUntilSaturday * 86400) + (targetSecsToday - targetDaySecs)
            else
                diffSecs = targetSecsToday - targetDaySecs
            end

            local d = math.floor(diffSecs / 86400)
            local h = math.floor((diffSecs % 86400) / 3600)
            local m = math.floor((diffSecs % 3600) / 60)
            local s = diffSecs % 60

            EventCountdownLbl.Text = string.format("⏰ متبقي: %d يوم %02d:%02d:%02d", d, h, m, s)
        end)
        task.wait(1)
    end
end)


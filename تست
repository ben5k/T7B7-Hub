-- حماية من حقن RichText في الشات
function Ben.esc(s)
    s = tostring(s == nil and "" or s)
    s = s:gsub("&", "&amp;")
    s = s:gsub("<", "&lt;")
    s = s:gsub(">", "&gt;")
    s = s:gsub('"', "&quot;")
    s = s:gsub("'", "&apos;")
    return s
end

-- ============ محرك المؤثرات الصوتية ============
pcall(function()
    local S = Ben.sfx
    local SoundService = game:GetService("SoundService")
    local PING = "rbxasset://sounds/electronicpingshort.wav"
    local probing = false
    local lastAt = {}

    local SEQ = {
        click = {vol = 0.28, {1.6, 0}},
        hover = {vol = 0.06, {2.4, 0}},
        tick = {vol = 0.16, {1.5, 0}},
        tab = {vol = 0.30, {1.2, 0}, {1.7, 0.05}},
        open = {vol = 0.32, {1.0, 0}, {1.5, 0.06}, {2.0, 0.12}},
        close = {vol = 0.30, {2.0, 0}, {1.5, 0.06}, {1.0, 0.12}},
        on = {vol = 0.30, {1.5, 0}, {2.0, 0.06}},
        off = {vol = 0.30, {2.0, 0}, {1.4, 0.06}},
        success = {vol = 0.34, {1.26, 0}, {1.5, 0.08}, {2.0, 0.16}},
        error = {vol = 0.36, {0.7, 0}, {0.55, 0.10}},
        send = {vol = 0.30, {1.8, 0}, {2.4, 0.05}},
        receive = {vol = 0.26, {2.0, 0}, {1.5, 0.07}},
        notify = {vol = 0.30, {1.6, 0}, {2.1, 0.08}, {1.6, 0.16}},
        login = {vol = 0.36, {1.0, 0}, {1.26, 0.08}, {1.5, 0.16}, {2.0, 0.24}, {2.52, 0.34}},
        done = {vol = 0.38, {1.5, 0}, {2.0, 0.09}, {2.52, 0.18}, {3.0, 0.30}}
    }

    local function ensure()
        if S.ok ~= nil then return S.ok end
        if probing then
            local w0 = os.clock()
            while S.ok == nil and os.clock() - w0 < 2 do task.wait(0.05) end
            return S.ok == true
        end
        probing = true
        local probe = Instance.new("Sound")
        probe.SoundId = PING
        probe.Volume = 0
        probe.Parent = SoundService
        local t0 = os.clock()
        while not probe.IsLoaded and os.clock() - t0 < 1.5 do task.wait(0.05) end
        S.ok = (probe.IsLoaded and probe.TimeLength > 0) and true or false
        probe:Destroy()
        probing = false
        return S.ok
    end

    local function note(speed, vol)
        local s = Instance.new("Sound")
        s.SoundId = PING
        s.Volume = vol
        s.PlaybackSpeed = speed
        s.Parent = SoundService
        s:Play()
        task.delay(1.2, function() s:Destroy() end)
        return s
    end

    function S.play(kind)
        if not Ben.soundOn then return end
        local seq = SEQ[kind]
        if not seq then return end
        local now = os.clock()
        local gap = (kind == "hover") and 0.09 or 0.03
        if lastAt[kind] and now - lastAt[kind] < gap then return end
        lastAt[kind] = now
        task.spawn(function()
            if not ensure() then return end
            for _, n in ipairs(seq) do
                task.delay(n[2], function()
                    if Ben.soundOn then pcall(note, n[1], seq.vol) end
                end)
            end
        end)
    end

    -- صوت "ووش" بانزلاق النغمة (لشاشة التحميل)
    function S.sweep()
        if not Ben.soundOn then return end
        task.spawn(function()
            if not ensure() then return end
            if not Ben.soundOn then return end
            pcall(function()
                local s = note(0.5, 0.3)
                TweenService:Create(s, TweenInfo.new(0.45, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {PlaybackSpeed = 2.6, Volume = 0}):Play()
            end)
        end)
    end
end)

-- ============ مؤثرات حركية بسيطة ============
function Ben.fx.scaleOf(obj)
    local sc = obj:FindFirstChild("BenScale")
    if not sc then
        sc = Instance.new("UIScale")
        sc.Name = "BenScale"
        sc.Parent = obj
    end
    return sc
end

function Ben.fx.popIn(obj, dur)
    pcall(function()
        local sc = Ben.fx.scaleOf(obj)
        local fit = obj:GetAttribute("BenFit") or 1
        sc.Scale = fit * 0.88
        TweenService:Create(sc, TweenInfo.new(dur or 0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = fit}):Play()
    end)
end

function Ben.fx.slideTab(tab)
    pcall(function()
        tab.Position = UDim2.new(0, 14, 0, 0)
        TweenService:Create(tab, TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
    end)
end


local function make(className, props, parent)
    local obj = Instance.new(className)
    for k, v in pairs(props) do
        obj[k] = v
    end
    obj.Parent = parent
    return obj
end

local function corner(obj, px)
    make("UICorner", {CornerRadius = UDim.new(0, px)}, obj)
end

local function stroke(obj, color, transparency, thickness)
    return make("UIStroke", {
        Color = color,
        Transparency = transparency or 0,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    }, obj)
end

local function gradient(obj, color1, color2, rotation)
    make("UIGradient", {
        Color = ColorSequence.new(color1, color2),
        Rotation = rotation or 0
    }, obj)
end

local function tween(obj, seconds, props)
    TweenService:Create(
        obj,
        TweenInfo.new(seconds, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    ):Play()
end

local function label(parent, text, size, position, textSize, color, font, align, z)
    return make("TextLabel", {
        BackgroundTransparency = 1,
        Text = text,
        Size = size,
        Position = position,
        TextColor3 = color or C.white,
        Font = font or Enum.Font.Gotham,
        TextSize = textSize or 12,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextWrapped = true,
        ZIndex = z or 5
    }, parent)
end

-- Responsive sizing: leave a safe margin so the window never clips off-screen.
local uiScale = make("UIScale", {Scale = 1}, gui)
local camera = workspace.CurrentCamera
local function updateScale()
    camera = workspace.CurrentCamera
    local viewport = camera and camera.ViewportSize or Vector2.new(900, 650)
    local fitX = math.max(1, viewport.X - 24) / 700
    local fitY = math.max(1, viewport.Y - 24) / 440
    uiScale.Scale = math.clamp(math.min(fitX, fitY), 0.42, 1)
end
updateScale()
if camera then camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale) end


        TextColor3 = WHITE,
        TextSize = 11,
        Font = Enum.Font.GothamBold
    }, box)

    Corner(Bigger, 8)

    local currentScale = 0.88

    Smaller.MouseButton1Click:Connect(function()

        currentScale = math.max(0.65, currentScale - 0.07)
        Resize(currentScale)

    end)

    Bigger.MouseButton1Click:Connect(function()

        currentScale = math.min(0.96, currentScale + 0.07)
        Resize(currentScale)

    end)

    local Reset = Create("TextButton", {
        Position = UDim2.fromOffset(12, 135),

local function pressFx(btn, strength, silent)
	local sc = new("UIScale", { Parent = btn }); btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 1 - (strength or 0.05) }):Play() end)
	local function up() tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back):Play() end
	btn.MouseButton1Up:Connect(up); btn.MouseLeave:Connect(up)
	if not silent then btn.MouseButton1Click:Connect(click) end
end

--// Image Downloader
local function downloadImage(url, file)
	if not url or url == "" then return nil end
	if typeof(writefile) ~= "function" or typeof(getcustomasset) ~= "function" then return nil end
	local data
	local req = (typeof(request) == "function" and request) or (typeof(http_request) == "function" and http_request) or (typeof(syn) == "table" and syn.request) or nil
	if req then local ok, res = pcall(req, { Url = url, Method = "GET" }); if ok and res and type(res.Body) == "string" then data = res.Body end end
	if not data then local ok, body = pcall(function() return game:HttpGet(url) end); if ok and type(body) == "string" then data = body end end
	if not data then return nil end
	local ok, asset = pcall(function() writefile(file, data); return getcustomasset(file) end)
	return ok and asset or nil
end


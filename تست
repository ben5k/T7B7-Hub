function Card:AddLabel(o)
	local l = label({ Weight = o.Weight or "Medium", TextSize = o.Size or 12, TextColor3 = o.Color or Theme.Muted, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, Parent = self.Body })
	if o.NoTranslate then l.Text = o.Text else bind(l, o.Text) end; register(self, l, o); return l
end

local function applySearch()
	local q = string.lower(SearchBox.Text)
	for _, card in ipairs(Kaizo.Cards) do
		local titleMatch = q == "" or string.find(card.TitleText, q, 1, true) ~= nil
		local any = false
		for _, el in ipairs(card.Elements) do
			local vis = titleMatch or string.find(el.Text, q, 1, true) ~= nil
			el.Frame.Visible = vis; any = any or vis
		end
		card.Frame.Visible = any or titleMatch
	end
end
connect(SearchBox:GetPropertyChangedSignal("Text"), applySearch)


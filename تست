local function sendChatMessage()
	local msg = ChatInputBox.Text
	if msg ~= "" then
		ChatInputBox.Text = ""
		pcall(function()
			customRequest({
				Url = FIREBASE_CHAT_URL, Method = "POST",
				Headers = {["Content-Type"] = "application/json"},
				Body = HttpService:JSONEncode({
					sender = LocalPlayer.DisplayName ~= "" and LocalPlayer.DisplayName or LocalPlayer.Name,
					userId = LocalPlayer.UserId, text = msg, time = os.time()
				})
			})
		end)
	end
end
SendBtn.MouseButton1Click:Connect(sendChatMessage)
ChatInputBox.FocusLost:Connect(function(enter) if enter then sendChatMessage() end end)

local renderedMsgs = {}
task.spawn(function()
	while true do
		pcall(function()
			local res = customRequest({Url = FIREBASE_CHAT_URL, Method = "GET"})
			if res and res.StatusCode == 200 then
				local data = safeDecode(res.Body)
				if data then
					for k, m in pairs(data) do
						if type(m) == "table" and m.text and not renderedMsgs[k] then
							renderedMsgs[k] = true
							local msgFrame = new("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = Theme.Card, Parent = ChatScroll }, { corner(6) })
							label({ Size = UDim2.new(1, -10, 0, 15), Position = UDim2.fromOffset(5, 2), Text = m.sender, TextColor3 = Theme.Accent, TextSize = 11, Weight = "Bold", Parent = msgFrame })
							label({ Size = UDim2.new(1, -10, 0, 20), Position = UDim2.fromOffset(5, 18), Text = m.text, TextSize = 12, TextWrapped = true, Parent = msgFrame })
							
							task.defer(function()
								local layout = ChatScroll:FindFirstChildOfClass("UIListLayout")
								ChatScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
								ChatScroll.CanvasPosition = Vector2.new(0, ChatScroll.AbsoluteCanvasSize.Y)
							end)
						end
					end
				end
			end
		end)
		task.wait(2.5)
	end
end)


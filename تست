-- استدعاء مكتبة Kaizo UI
local Kaizo = loadstring(game:HttpGet("https://raw.githubusercontent.com/Krypton-Skript/Kaizo-Library/main/Source.lua"))()

-- إنشاء النافذة الرئيسية للتطبيق
local Window = Kaizo:CreateWindow({
    Title = "لوحة التحكم | السكربت المدمج",
    Subtitle = "نسخة المطور",
    Icon = "⭐"
})

-- إنشاء صفحة (Tab)
local MainTab = Window:AddTab({ Title = "الرئيسية", Icon = "🏠" })

-- إنشاء الأقسام (Cards) لتنظيم الأزرار
local ScriptCard = MainTab:AddCard({ Title = "سكربتات الصيد", Icon = "⚡", Side = "Left" })
local ServerCard = MainTab:AddCard({ Title = "إدارة السيرفرات", Icon = "🌍", Side = "Right" })

-- 1. زر تشغيل السكربت الخارجي (مع الحماية من خطأ nil value)
ScriptCard:AddButton({
    Title = "تشغيل سكربت فلفل 🌶️",
    Callback = function()
        local success, err = pcall(function()
            local scriptUrl = "https://raw.githubusercontent.com/tienkhanh1/spicy/main/Chilli.lua"
            local scriptCode = game:HttpGet(scriptUrl)
            
            -- جلب السكربت والتحقق منه قبل التشغيل
            local loadedScript = loadstring(scriptCode)
            
            if loadedScript then
                loadedScript()
                Kaizo:Notify({Title="نجاح", Text="تم تفعيل السكربت بنجاح!", Icon="✅"})
            else
                Kaizo:Notify({Title="تنبيه", Text="فشل جلب الكود، تأكد من دعم المحرك لـ loadstring", Icon="⚠️"})
            end
        end)

        if not success then
            warn("حدث خطأ أثناء التشغيل: " .. tostring(err))
            Kaizo:Notify({Title="خطأ", Text="حدث خطأ غير متوقع", Icon="❌"})
        end
    end
})

-- 2. زر ميزة البحث والانتقال لسيرفر آخر (Server Hop)
ServerCard:AddButton({
    Title = "الانتقال لسيرفر عشوائي (Server Hop)",
    Callback = function()
        Kaizo:Notify({Title="جاري البحث", Text="جاري البحث عن سيرفر مناسب...", Icon="🔍"})
        
        local Http = game:GetService("HttpService")
        local TPS = game:GetService("TeleportService")
        local Api = "https://games.roblox.com/v1/games/"
        local _place = game.PlaceId
        local _servers = Api..tostring(_place).."/servers/Public?sortOrder=Asc&limit=100"
        
        -- دالة مساعدة لجلب قائمة السيرفرات
        local function ListServers(cursor)
            local Raw = game:HttpGet(_servers .. ((cursor and "&cursor="..cursor) or ""))
            return Http:JSONDecode(Raw)
        end
        
        -- تنفيذ الانتقال
        local success, err = pcall(function()
            local Server, Next; repeat
                local Servers = ListServers(Next)
                Server = Servers.data[math.random(1, #Servers.data)] -- اختيار سيرفر عشوائي من القائمة
                Next = Servers.nextPageCursor
            until Server
            
            TPS:TeleportToPlaceInstance(_place, Server.id, game.Players.LocalPlayer)
        end)
        
        if not success then
            Kaizo:Notify({Title="خطأ بالانتقال", Text="لم نتمكن من العثور على سيرفر", Icon="❌"})
        end
    end
})

-- إشعار عند اكتمال تحميل الواجهة بنجاح
Kaizo:Notify({
    Title = "مرحباً!",
    Text = "تم تحميل الواجهة بالكامل وجاهزة للاستخدام.",
    Icon = "🚀"
})

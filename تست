local function readLocalEggStats()
    local speed, money = nil, nil
    local leaderstats = LocalPlayer:FindFirstChild("leaderstats")
    if leaderstats then
        for _, child in ipairs(leaderstats:GetChildren()) do
            if child:IsA("IntValue") or child:IsA("NumberValue") then
                local low = string.lower(child.Name)
                if speed == nil and (low:find("speed", 1, true) or low:find("velocity", 1, true) or low:find("سرعة", 1, true)) then speed = tonumber(child.Value) end
                if money == nil and (low:find("money", 1, true) or low:find("cash", 1, true) or low:find("coin", 1, true) or low:find("currency", 1, true) or low:find("dollar", 1, true) or low:find("فلوس", 1, true) or low:find("مال", 1, true)) then money = tonumber(child.Value) end
            end
        end
    end
    return speed, money
end


local function applyChatBackground(idx)
    idx = tonumber(idx) or 0
    selectedChatBgIndex = idx
    if idx > 0 and wallUrls[idx] then
        ChatBgImage.Image = wallUrls[idx]
        ChatBgImage.Visible = true
        ChatWin.BackgroundTransparency = 0
        ChatWin.BackgroundColor3 = Color3.fromRGB(7, 13, 26)
        ChatBgImage.ImageTransparency = 0
    else
        ChatBgImage.Image = ""
        ChatBgImage.Visible = false
        ChatWin.BackgroundTransparency = 0
        ChatWin.BackgroundColor3 = Color3.fromRGB(7, 13, 26)
    end
    saveUserSettings()
end

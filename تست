        LeftWing.Size = UDim2.new(0, 105, 1, -48)
        LeftWing.Position = UDim2.new(0.5, -280, 0, 48)
        RightWing.Size = UDim2.new(0, 105, 1, -48)
        RightWing.Position = UDim2.new(0.5, 175, 0, 48)
        LeftWing.ScrollingDirection = Enum.ScrollingDirection.Y
        RightWing.ScrollingDirection = Enum.ScrollingDirection.Y
        LeftWing.ScrollBarThickness = 0
        RightWing.ScrollBarThickness = 0
        LeftLayout.FillDirection = Enum.FillDirection.Vertical

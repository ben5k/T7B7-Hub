local function showDeveloperBroadcast(data)
    if type(data) ~= "table" or type(data.text) ~= "string" or data.text == "" then return end
    broadcastSequence = broadcastSequence + 1
    local thisSequence = broadcastSequence

    local developerUserId = tonumber(data.userId) or 0
    if developerUserId > 0 then
        BroadcastAvatar.Image = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(developerUserId) .. "&w=150&h=150"
    end
    BroadcastName.Text = "Dms921"
    BroadcastMessage.Text = data.text

    BroadcastWrap.Visible = true
    BroadcastWrap.Position = UDim2.new(0.5, 0, 0, -52)
    TweenService:Create(BroadcastWrap, TweenInfo.new(0.32, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, 0, 0, 8)
    }):Play()

    pcall(function()
        BroadcastSound:Stop()
        BroadcastSound.TimePosition = 0
        BroadcastSound:Play()
    end)

    task.delay(6, function()
        if broadcastSequence ~= thisSequence or not BroadcastWrap or not BroadcastWrap.Parent then return end
        local hideTween = TweenService:Create(BroadcastWrap, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, 0, 0, -52)
        })
        hideTween:Play()
        hideTween.Completed:Wait()
        if broadcastSequence == thisSequence and BroadcastWrap and BroadcastWrap.Parent then
            BroadcastWrap.Visible = false
        end
    end)
end


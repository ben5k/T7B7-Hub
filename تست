        local t = now - st.t0

        -- تقدّم ناعم مع زحف بسيط حتى لا يبدو عالقاً
        local goal = math.min(1, st.target + (st.finishing and 0 or math.min(0.05, t * 0.004)))
        if st.shown < goal then
            st.shown = math.min(goal, st.shown + math.max(dt * 0.9, (goal - st.shown) * dt * 4))
        end
        local p = st.shown
        fill.Size = UDim2.new(p, 0, 1, 0)
        pctLbl.Text = tostring(math.floor(p * 100 + 0.5)) .. "%"
        head.Visible = p > 0.01 and p < 0.995
        head.Position = UDim2.new(p, 0, 0.5, 0)
        headStroke.Transparency = 0.4 + 0.2 * math.sin(t * 9)
        sheen.Position = UDim2.new(0, -40 + ((t / 1.0) % 1) * 380, 0, 0)

        ringGrad.Rotation = (t * 140) % 360
        local k = (t * 0.9) % 1
        local ps = 112 + 56 * k
        pulse.Size = UDim2.new(0, ps, 0, ps)
        pulseStroke.Transparency = 0.2 + 0.8 * k
        local bob = math.sin(t * 2.2) * 2.5
        emblem.Position = UDim2.new(0.5, 0, 0, 62 + bob)

        glowRed.Position = UDim2.new(0.3 + 0.04 * math.sin(t * 0.5), 0, 0.35 + 0.03 * math.cos(t * 0.4), 0)
        glowGold.Position = UDim2.new(0.72 + 0.04 * math.cos(t * 0.45), 0, 0.68 + 0.03 * math.sin(t * 0.55), 0)
        for _, s in ipairs(stars) do
            s.y = (s.y - s.sp * dt) % 1
            s.obj.Position = UDim2.new(s.x, 0, s.y, 0)
        end

        for _, l in ipairs(letters) do
            local lt = math.clamp((t - 0.25 - l.delay) / 0.5, 0, 1)
            local e = 1 - (1 - lt) ^ 3
            local over = (lt < 1) and 0 or math.sin(t * 2 + l.x * 0.03) * 1.5
            l.obj.Position = UDim2.new(0, l.x, 0, -60 + 64 * e + over)
        end
        local cyc = ((t - 1.2) / 2.8) % 1
        shimmer.Position = UDim2.new(0, -80 + cyc * 560, 0, -16)

        if now - lastTip > 2.6 then
            lastTip = now
            tipIdx = (tipIdx % #tips) + 1
            tipLbl.Text = tips[tipIdx]
        end
        local fa = math.clamp((now - st.flash) / 0.4, 0, 1)
        if st.flash > 0 and fa < 1 then
            ringStroke.Thickness = 3 + 4 * (1 - fa)
        end
    end)
end)




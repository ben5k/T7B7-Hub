local renderedBroadcasts = {}
task.spawn(function()
	while true do
		pcall(function()
			local res = customRequest({Url = FIREBASE_BROADCAST_URL, Method = "GET"})
			if res and res.StatusCode == 200 then
				local data = safeDecode(res.Body)
				if data then
					for k, b in pairs(data) do
						if type(b) == "table" and b.text and not renderedBroadcasts[k] then
							renderedBroadcasts[k] = true
							if (os.time() - (b.time or 0)) < 30 then
								Kaizo:Notify({ Title = "إعلان إداري من " .. b.sender, Text = b.text, Icon = "📢", Duration = 8 })
							end
						end
					end
				end
			end
		end)
		task.wait(3)
	end
end)


applyResponsiveMain = function()
    local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(1280, 720)
    local narrow = viewport.X < 650 or viewport.Y < 430
    responsiveState.narrow = narrow

    if narrow then
        local width = math.max(300, math.floor(viewport.X - 12))
        local height = math.max(300, math.min(560, math.floor(viewport.Y - 16)))
        responsiveState.mainSize = UDim2.new(0, width, 0, height)
        responsiveState.mainPosition = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.Size = responsiveState.mainSize
        MainFrame.Position = responsiveState.mainPosition
    else
        responsiveState.mainSize = UDim2.new(0, 560, 0, 360)
        responsiveState.mainPosition = UDim2.new(0.5, 0, 0.5, 0)
        MainFrame.Size = responsiveState.mainSize
        MainFrame.Position = responsiveState.mainPosition
    end
end
applyResponsiveMain()

local function createProStyleBtn(text, side)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -4, 0, 40)
    btn.BackgroundColor3 = Color3.fromRGB(32, 10, 15)
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.AutoButtonColor = false
    btn.Parent = (side == "left") and LeftWing or RightWing
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 12)

    local stroke = Instance.new("UIStroke")
    stroke.Color = currentAccentColor
    stroke.Thickness = 1.45
    stroke.Parent = btn

    table.insert(registeredWingStrokes, stroke)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(145, 25, 35)
        }):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            BackgroundColor3 = Color3.fromRGB(32, 10, 15)
        }):Play()
    end)
    return btn
end

local function clearCenter()
    for _, child in ipairs(CenterScroll:GetChildren()) do

    end

    -- الشمس
    local sunGlow = circle(318, 14, 74, Color3.fromRGB(255, 244, 150), 2)
    sunGlow.BackgroundTransparency = 0.65
    local sun = circle(330, 26, 50, Color3.fromRGB(236, 232, 92), 2)

    -- الغيوم
    local clouds = {}
    local function makeCloud(y, scale, speed, phase)
        local c = Instance.new("Frame")
        c.Size = UDim2.new(0, 64 * scale, 0, 30 * scale)
        c.BackgroundTransparency = 1
        c.ZIndex = 2
        c.Parent = LoadFrame
        local function puff(x, yy, w, h)
            local p = Instance.new("Frame")
            p.Position = UDim2.new(0, x * scale, 0, yy * scale)
            p.Size = UDim2.new(0, w * scale, 0, h * scale)
            p.BackgroundColor3 = WHITE
            p.BackgroundTransparency = 0.04
            p.BorderSizePixel = 0
            p.ZIndex = 2
            p.Parent = c
            Instance.new("UICorner", p).CornerRadius = UDim.new(1, 0)
        end
        puff(0, 12, 64, 18)
        puff(8, 4, 26, 26)
        puff(24, 0, 30, 30)
        puff(44, 8, 18, 18)
        clouds[#clouds + 1] = {obj = c, y = y, speed = speed, phase = phase}
    end
    makeCloud(24, 1.0, 9, 0.1)
    makeCloud(74, 0.7, 6, 0.55)
    makeCloud(116, 0.85, 7.5, 0.82)

    -- تلال خضراء
    local function hill(x, y, d, col, rim)
        local h = circle(x, y, d, col, 3)
        local s = Instance.new("UIStroke")
        s.Color = rim
        s.Thickness = 3
        s.Parent = h
        return h
    end
    hill(-80, 190, 200, Color3.fromRGB(72, 178, 52), Color3.fromRGB(40, 120, 38))
    hill(250, 214, 170, Color3.fromRGB(84, 190, 60), Color3.fromRGB(40, 120, 38))
    hill(150, 246, 90, Color3.fromRGB(110, 205, 80), Color3.fromRGB(50, 140, 44))

    -- الأرض: طوب برتقالي
    local ground = Instance.new("Frame")
    ground.Size = UDim2.new(1, 0, 0, 36)

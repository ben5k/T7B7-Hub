local function getHelpPanelSize()
    local viewport = getViewportSize()
    local width = math.max(260, math.min(420, math.floor(viewport.X - 32)))
    local height = math.max(250, math.min(286, math.floor(viewport.Y - 80)))
    return width, height
end

local applyResponsiveHelp
applyResponsiveHelp = function()
    local width, height = getHelpPanelSize()
    HelpPanel.Position = UDim2.new(0.5, -math.floor(width / 2), 0.5, -math.floor(height / 2))
    HelpPanel.Size = UDim2.new(0, width, 0, height)
    HelpBody.Size = UDim2.new(1, -32, 0, math.max(120, height - 136))
    HelpBody.TextSize = width < 350 and 11 or 12
    HelpFoot.TextSize = width < 350 and 8 or 9
end

local function closeHelpPanel()
    TweenService:Create(HelpPanel, TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0)
    }):Play()
    task.delay(0.19, function()
        if HelpOverlay and HelpOverlay.Parent then
            HelpOverlay.Visible = false
            applyResponsiveHelp()
        end
    end)
end

local function openHelpPanel()
    applyResponsiveHelp()
    HelpOverlay.Visible = true
    HelpPanel.Size = UDim2.new(0, 0, 0, 0)
    local width, height = getHelpPanelSize()
    TweenService:Create(HelpPanel, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, width, 0, height)
    }):Play()
end


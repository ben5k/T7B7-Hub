local function applyDeveloperTag(plr)
    if plr.Name ~= "Dms921" then return end
    if not plr.Character then return end
    local head = plr.Character:WaitForChild("Head", 5)
    if not head then return end

    if head:FindFirstChild("KEONDevTag") then head.KEONDevTag:Destroy() end

    local bb = Instance.new("BillboardGui")
    bb.Name = "KEONDevTag"
    bb.Size = UDim2.new(0, 260, 0, 65)
    bb.StudsOffset = Vector3.new(0, 3.2, 0)
    bb.AlwaysOnTop = true
    bb.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 1, 0)
    lbl.BackgroundTransparency = 1
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 22
    lbl.Text = "✦ KEON HUB ✦"
    lbl.TextColor3 = Color3.fromRGB(255, 215, 0)
    lbl.Parent = bb

    local textStroke = Instance.new("UIStroke")
    textStroke.Color = Color3.fromRGB(0, 0, 0)
    textStroke.Thickness = 3
    textStroke.Parent = lbl

    task.spawn(function()
        while lbl and lbl.Parent do
            for i = 0, 1, 0.015 do
                if not lbl or not lbl.Parent then break end
                lbl.TextColor3 = Color3.fromHSV(i, 1, 1)
                task.wait(0.04)
            end
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do

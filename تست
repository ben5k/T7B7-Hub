	tabOrder += 1
	if o.Section and o.Section ~= lastSection then
		lastSection = o.Section
		local sl = label({ Size = UDim2.new(1, 0, 0, 24), TextSize = 10, Weight = "ExtraBold", TextColor3 = Theme.SideMuted, LayoutOrder = tabOrder, Parent = TabScroll }, { pad(6, 8, 6, 0) })
		bind(sl, string.upper(o.Section)); tabOrder += 1
	end
	local btn = new("TextButton", { Size = UDim2.new(1, 0, 0, 42), Text = "", AutoButtonColor = false, BackgroundColor3 = Theme.TabActive, BackgroundTransparency = 1, LayoutOrder = tabOrder, Parent = TabScroll }, { corner(12) })
	local st = stroke(Theme.Border, 2); st.Enabled = false; st.Parent = btn
	emoji(btn, o.Icon or "•", 20, UDim2.fromOffset(6, 5), UDim2.fromOffset(32, 32))
	local nameLbl = label({ Size = UDim2.new(1, -48, 1, 0), Position = UDim2.fromOffset(42, 0), TextSize = 13, Weight = "ExtraBold", TextColor3 = Theme.SideText, TextTruncate = Enum.TextTruncate.AtEnd, Parent = btn })
	bind(nameLbl, o.Name)

	local page = new("ScrollingFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, ScrollBarImageColor3 = Theme.Border, AutomaticCanvasSize = Y, CanvasSize = UDim2.new(), Visible = false, Parent = Pages }, { pad(14, 4, 14, 12) })
	local cols = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, Parent = page }, { list(10, Enum.FillDirection.Horizontal) })
	local left = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Y, LayoutOrder = 1, Parent = cols }, { list(10) })
	local right = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, -5, 0, 0), AutomaticSize = Y, LayoutOrder = 2, Parent = cols }, { list(10) })

	local tab = setmetatable({ Title = o.Title or o.Name, Subtitle = o.Subtitle, Button = btn, Stroke = st, NameLabel = nameLbl, Page = page, Left = left, Right = right, Count = 0, Selected = false }, Tab)
	table.insert(Kaizo.Tabs, tab)
	btn.MouseEnter:Connect(function() if not tab.Selected then tween(btn, 0.12, { BackgroundTransparency = 0.85 }):Play() end end)

--==================================================
-- BACKGROUND DOWNLOAD
--==================================================

local function DownloadBackground()

    local requestFunc = request or http_request

    if not requestFunc and syn then
        requestFunc = syn.request
    end

    if not requestFunc or not writefile then
        return nil
    end

    local success, response = pcall(function()
        return requestFunc({
            Url = CONFIG.BackgroundURL,
            Method = "GET"
        })
    end)

    if not success or not response then
        return nil
    end

    if response.Success == false
        or (response.StatusCode and response.StatusCode ~= 200) then
        return nil
    end

    if not response.Body or #response.Body == 0 then
        return nil
    end

    local saved = pcall(function()
        writefile(CONFIG.ImageFile, response.Body)
    end)

    if not saved then
        return nil
    end

    local assetFunc = getcustomasset or getsynasset

    if not assetFunc then
        return nil
    end

    local assetSuccess, asset = pcall(function()
        return assetFunc(CONFIG.ImageFile)
    end)

    if assetSuccess then
        return asset
    end

    return nil
end


Ben.load.set(0.97, "اللمسات الأخيرة…")

pcall(function()
    local UserInputService = game:GetService("UserInputService")
    local touchOnly = UserInputService.TouchEnabled and not UserInputService.MouseEnabled

    -- ملاءمة حجم النوافذ للشاشات الصغيرة (من المنتصف)
    local function applyFit(obj, w, h)
        local cam = workspace.CurrentCamera
        local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
        local f = math.clamp(math.min((vp.X - 16) / w, (vp.Y - 16) / h), 0.5, 1)
        obj:SetAttribute("BenFit", f)
        Ben.fx.scaleOf(obj).Scale = f
    end
    applyFit(Main, 530, 290)
    applyFit(ChatWindow, 390, 290)
    local cam = workspace.CurrentCamera
    if cam then
        cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            applyFit(Main, 530, 290)
            applyFit(ChatWindow, 390, 290)
        end)
    end

    -- تفاعل الأزرار: ضغط/تحويم + مؤثر صوتي (يُحدَّد النوع عبر Attribute اسمه Sfx)
    local function hook(b)
        if b:GetAttribute("BenHooked") then return end
        b:SetAttribute("BenHooked", true)
        local sc = Instance.new("UIScale")
        sc.Name = "BenBtn"
        sc.Parent = b
        local hover, down = false, false
        local function apply()
            local goal = down and 0.95 or ((hover and not touchOnly) and 1.025 or 1)
            TweenService:Create(sc, TweenInfo.new(down and 0.06 or 0.15, down and Enum.EasingStyle.Quad or Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = goal}):Play()
        end
        b.MouseEnter:Connect(function()
            hover = true
            apply()
            if not touchOnly then Ben.sfx.play("hover") end
        end)
        b.MouseLeave:Connect(function()
            hover = false
            down = false
            apply()
        end)
        b.MouseButton1Down:Connect(function()
            down = true
            apply()
        end)
        b.MouseButton1Up:Connect(function()
            down = false
            apply()
        end)
        b.MouseButton1Click:Connect(function()
            local k = b:GetAttribute("Sfx")
            if k ~= "none" then Ben.sfx.play(k or "click") end
        end)
    end
    for _, gui in ipairs({ScreenGui, LoginGui, BroadcastGui}) do
        for _, d in ipairs(gui:GetDescendants()) do
            if d:IsA("TextButton") or d:IsA("ImageButton") then pcall(hook, d) end
        end
        gui.DescendantAdded:Connect(function(d)
            if d:IsA("TextButton") or d:IsA("ImageButton") then pcall(hook, d) end
        end)
    end

    -- حالة السيرفر الحيّة
    local function refreshStatus()
        ServerStatus.Text = "🟢 أونلاين: " .. #Players:GetPlayers() .. "/" .. Players.MaxPlayers .. " لاعبين"
    end
    Players.PlayerAdded:Connect(refreshStatus)
    Players.PlayerRemoving:Connect(function() task.defer(refreshStatus) end)

    -- عدّاد المستخدمين النشطين الحقيقي (بدل الرقم الثابت)
    task.spawn(function()
        while ScreenGui and ScreenGui.Parent do
            if Main.Visible then
                pcall(function()
                    local res = customRequest({Url = FIREBASE_PRESENCE_URL .. ".json", Method = "GET"})
                    if res and res.StatusCode == 200 and res.Body ~= "" and res.Body ~= "null" then
                        local data = HttpService:JSONDecode(res.Body)
                        if type(data) == "table" then
                            local n, now = 0, os.time()
                            for _, u in pairs(data) do
                                if type(u) == "table" and type(u.time) == "number" and now - u.time < 35 then
                                    n = n + 1
                                end
                            end
                            UsersLbl.Text = "⚡ " .. tostring(n) .. " مستخدم\nنشط الآن"
                        end
                    end
                end)
            end
            task.wait(12)
        end
    end)
end)


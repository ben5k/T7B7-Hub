local function loadUserSettings()
    if readfile and isfile and isfile(CONFIG_FILE) then
        pcall(function()
            local cfg = safeDecode(readfile(CONFIG_FILE))
            if cfg then
                selectedScriptBgIndex = math.clamp(tonumber(cfg.scriptBg) or 0, 0, #wallUrls)
                selectedChatBgIndex = math.clamp(tonumber(cfg.chatBg) or 0, 0, #wallUrls)
                if cfg.showOwnCountryOverhead ~= nil then showOwnCountryOverhead = cfg.showOwnCountryOverhead end
                uiScaleValue = math.clamp(tonumber(cfg.uiScaleValue) or 1.0, 0.75, 1.2)
                KEONProfile.selectedCountryFlag = cfg.countryFlag or KEONProfile.selectedCountryFlag
                KEONProfile.selectedCountryName = cfg.countryName or KEONProfile.selectedCountryName
                KEONProfile.selectedCountryCode = cfg.countryCode or KEONProfile.selectedCountryCode
                KEONCountryWasSaved = cfg.countryCode ~= nil
                if cfg.r and cfg.g and cfg.b then
                    currentAccentColor = Color3.new(cfg.r, cfg.g, cfg.b)
                end
                if cfg.hr and cfg.hg and cfg.hb then
                    currentHeaderColor = Color3.new(cfg.hr, cfg.hg, cfg.hb)
                end
            end
        end)
    end
end


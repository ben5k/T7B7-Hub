function KEONProfile.applyCountryTag(plr, flag, countryName)
    if not plr or not plr.Character then return end
    local head = plr.Character:FindFirstChild("Head")
    if not head then return end
    local existing = head:FindFirstChild("KEONCountryFlagTag")
    local tagText = tostring(flag or "🌐") .. "  " .. tostring(countryName or "غير محدد")
    if existing then
        local label = existing:FindFirstChild("CountryLabel")
        if label then label.Text = tagText end
        return
    end
    local billboard = Instance.new("BillboardGui")
    billboard.Name = "KEONCountryFlagTag"
    billboard.Size = UDim2.new(0, 190, 0, 28)
    billboard.StudsOffset = Vector3.new(0, 4.25, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = 160
    billboard.Parent = head
    local label = Instance.new("TextLabel")
    label.Name = "CountryLabel"
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundColor3 = Color3.fromRGB(5, 14, 29)
    label.BackgroundTransparency = 0.12
    label.BorderSizePixel = 0
    label.Text = tagText
    label.TextColor3 = Color3.fromRGB(245, 250, 255)
    label.TextStrokeTransparency = 0.35
    label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.GothamBold
    label.TextSize = 13
    label.Parent = billboard
    Instance.new("UICorner", label).CornerRadius = UDim.new(0, 8)
    local outline = Instance.new("UIStroke")
    outline.Color = currentAccentColor
    outline.Thickness = 1.25
    outline.Parent = label
end

function KEONProfile.refreshCountryTags()
    for _, plr in ipairs(Players:GetPlayers()) do
        local profile = KEONProfile.profileByUserId[tostring(plr.UserId)]
        if plr == LocalPlayer then
            KEONProfile.applyCountryTag(plr, KEONProfile.selectedCountryFlag, KEONProfile.selectedCountryName)
        elseif profile then
            KEONProfile.applyCountryTag(plr, profile.countryFlag, profile.countryName)
        end
    end
end

function KEONProfile.publishProfileCountry()
    KEONProfile.profileByUserId[tostring(LocalPlayer.UserId)] = {
        userId = LocalPlayer.UserId, name = LocalPlayer.Name,
        displayName = LocalPlayer.DisplayName,
        countryFlag = KEONProfile.selectedCountryFlag, countryName = KEONProfile.selectedCountryName,
        countryCode = KEONProfile.selectedCountryCode
    }
    saveUserSettings()
    KEONProfile.refreshCountryTags()
    task.spawn(function()
        pcall(function()
            customRequest({
                Url = FIREBASE_BASE_URL .. "/active_users/" .. tostring(LocalPlayer.UserId) .. ".json",
                Method = "PATCH",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode({countryFlag = KEONProfile.selectedCountryFlag, countryName = KEONProfile.selectedCountryName, countryCode = KEONProfile.selectedCountryCode})

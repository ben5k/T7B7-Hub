--// Helpers
local Y, X = Enum.AutomaticSize.Y, Enum.AutomaticSize.X
local function new(class, props, kids)
	local inst = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do if k == "Parent" then parent = v else inst[k] = v end end
	for _, c in ipairs(kids or {}) do c.Parent = inst end
	if parent then inst.Parent = parent end
	return inst
end
local function corner(r) return new("UICorner", { CornerRadius = UDim.new(0, r) }) end
local function stroke(col, th, tr) return new("UIStroke", { Color = col, Thickness = th or 1.5, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }) end
local function tstroke(col, th, tr) return new("UIStroke", { Color = col, Thickness = th or 2, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual, LineJoinMode = Enum.LineJoinMode.Round }) end
local function gradient(c1, c2, rot) return new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rot or 90 }) end
local function pad(l, t, r, b) return new("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }) end
local function list(p, dir) return new("UIListLayout", { Padding = UDim.new(0, p or 0), SortOrder = Enum.SortOrder.LayoutOrder, FillDirection = dir or Enum.FillDirection.Vertical }) end
local function tween(o, t, props, style, dir) return TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props) end
local function label(props)
	local w = props.Weight; props.Weight = nil
	local d = { BackgroundTransparency = 1, Font = FONT[w or "Bold"], TextSize = 13, Text = "", TextColor3 = Theme.Text, TextXAlignment = Enum.TextXAlignment.Left }
	for k, v in pairs(props) do d[k] = v end
	return new("TextLabel", d)
end
local function lighten(c, a) return c:Lerp(Color3.new(1, 1, 1), a or 0.4) end
local function darken(c, a) return c:Lerp(Color3.new(0, 0, 0), a or 0.25) end
local function fire(cb, ...) if cb then task.spawn(cb, ...) end end
local function richTitle(text)
	local out, i = "", 0
	for ch in text:gmatch(".") do i += 1; out ..= string.format('<font color="#%s">%s</font>', TitleColors[(i - 1) % #TitleColors + 1]:ToHex(), ch) end
	return out
end
local function emoji(parent, e, size, pos, boxSize) return label({ Size = boxSize or UDim2.fromOffset(size + 8, size + 8), Position = pos or UDim2.new(), Text = e, TextSize = size, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, Parent = parent }) end

local function playSound(id, vol)
	if not Config.Sounds or not id or id == "" then return end
	pcall(function()
		local s = Instance.new("Sound")
		s.SoundId = id
		s.Volume = vol or 0.5
		s.Parent = SoundService
		s:Play()
		task.delay(6, function() if s.Parent then s:Destroy() end end)
	end)
end
local function click() playSound(Config.ClickSound, 0.4) end
local function pressFx(btn, strength, silent)
	local sc = new("UIScale", { Parent = btn })
	btn.MouseButton1Down:Connect(function() tween(sc, 0.08, { Scale = 1 - (strength or 0.05) }):Play() end)
	local function up() tween(sc, 0.14, { Scale = 1 }, Enum.EasingStyle.Back):Play() end
	btn.MouseButton1Up:Connect(up)
	btn.MouseLeave:Connect(up)
	if not silent then btn.MouseButton1Click:Connect(click) end
end


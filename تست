local currentTab
local function refreshHeader()
	if not currentTab then return end
	PageTitle.Text = string.upper(tr(currentTab.Title)); PageSub.Text = tr(currentTab.Subtitle or "")
	local rtl = Lang == "AR"
	PageTitle.TextXAlignment = rtl and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	PageSub.TextXAlignment = rtl and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
end

local function applyLang()
	local rtl = Lang == "AR"
	for _, t in ipairs(Translatables) do
		if t.obj.Parent then
			t.obj[t.prop] = tr(t.key)
			if t.align == Enum.TextXAlignment.Left then t.obj.TextXAlignment = rtl and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left end
		end
	end
	for _, fn in ipairs(LangRefreshers) do fn() end
	SearchBox.TextXAlignment = rtl and Enum.TextXAlignment.Right or Enum.TextXAlignment.Left
	for code, b in pairs(langButtons) do b.BackgroundTransparency = (code == Lang) and 0 or 1 end
	refreshHeader()
end
for code, b in pairs(langButtons) do b.MouseButton1Click:Connect(function() Lang = code; applyLang() end) end

local function applySearch()
	local q = string.lower(SearchBox.Text)
	for _, card in ipairs(Kaizo.Cards) do
		local titleMatch = q == "" or string.find(card.TitleText, q, 1, true) ~= nil
		local any = false
		for _, el in ipairs(card.Elements) do
			local vis = titleMatch or string.find(el.Text, q, 1, true) ~= nil
			el.Frame.Visible = vis; any = any or vis
		end
		card.Frame.Visible = any or titleMatch
	end
end
connect(SearchBox:GetPropertyChangedSignal("Text"), applySearch)

local Tab, Card = {}, {}
Tab.__index, Card.__index = Tab, Card

local function paintTab(t, on)
	t.Selected = on; t.Stroke.Enabled = on
	tween(t.Button, 0.18, { BackgroundTransparency = on and 0 or 1 }):Play()
	t.NameLabel.TextColor3 = on and Theme.Text or Theme.SideText
end

local function selectTab(tab)
	currentTab = tab
	for _, t in ipairs(Kaizo.Tabs) do local on = t == tab; t.Page.Visible = on; paintTab(t, on) end
	tab.Page.Position = UDim2.fromOffset(0, 16)
	tween(tab.Page, 0.3, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint):Play()
	refreshHeader()
end

local tabOrder, lastSection = 0, nil

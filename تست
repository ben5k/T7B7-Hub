local function setOpen(v)
	isOpen = v
	if v then
		Bubble.Visible = false; Window.Visible = true
		tween(WinScale, 0.35, { Scale = baseScale }, Enum.EasingStyle.Back):Play()
	else
		local tw = tween(WinScale, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		tw:Play()
		tw.Completed:Connect(function() if not isOpen then Window.Visible = false; Bubble.Visible = true end end)
	end
end
function Kaizo:SetOpen(v) setOpen(v and true or false) end

do
	local down, moved, startInput, startPos
	BubbleTile.InputBegan:Connect(function(i)
		if isPointer(i) then
			down, moved, startInput, startPos = true, false, i.Position, Bubble.Position
			tween(BubbleScale, 0.08, { Scale = 0.92 }):Play()
			i.Changed:Connect(function()
				if i.UserInputState == Enum.UserInputState.End and down then
					down = false; tween(BubbleScale, 0.15, { Scale = 1 }, Enum.EasingStyle.Back):Play()
					if not moved then click(); setOpen(true) end
				end
			end)
		end
	end)
	connect(UIS.InputChanged, function(i)
		if down and isMove(i) then
			local d = i.Position - startInput; if d.Magnitude > 6 then moved = true end
			if moved then Bubble.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y) end
		end
	end)
end

do

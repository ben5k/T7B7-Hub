-- جلب وإرسال الرسائل عبر Firebase Realtime Database REST API
local RenderedMessages = {}

local function AddChatMessageToUI(sender, message)
    local MsgLabel = Instance.new("TextLabel")
    MsgLabel.Size = UDim2.new(1, 0, 0, 0)
    MsgLabel.AutomaticSize = Enum.AutomaticSize.Y
    MsgLabel.BackgroundTransparency = 1
    MsgLabel.Text = "<b><font color='#FF455B'>" .. sender .. ":</font></b> " .. message
    MsgLabel.RichText = true
    MsgLabel.TextColor3 = Color3.fromRGB(240, 245, 250)
    MsgLabel.Font = Enum.Font.Gotham
    MsgLabel.TextSize = 12
    MsgLabel.TextXAlignment = Enum.TextXAlignment.Left
    MsgLabel.TextWrapped = true
    MsgLabel.ZIndex = 8
    MsgLabel.Parent = ChatScroll
end

local function SendMessageToFirebase(msg)
    if msg == "" then return end
    local payload = HttpService:JSONEncode({
        user = LocalPlayer.Name,
        text = msg,
        timestamp = os.time()
    })
    HttpRequest({
        Url = FIREBASE_CHAT_URL,
        Method = "POST",
        Headers = {["Content-Type"] = "application/json"},
        Body = payload
    })
end

local function FetchFirebaseMessages()
    local response = HttpRequest({ Url = FIREBASE_CHAT_URL, Method = "GET" })
    if response and response.Body then
        local success, data = pcall(function() return HttpService:JSONDecode(response.Body) end)
        if success and type(data) == "table" then
            for id, msgData in pairs(data) do
                if not RenderedMessages[id] and msgData.user and msgData.text then
                    RenderedMessages[id] = true
                    AddChatMessageToUI(msgData.user, msgData.text)
                end
            end
        end
    end
end

ChatSendBtn.MouseButton1Click:Connect(function()
    local text = ChatInputBox.Text
    ChatInputBox.Text = ""
    task.spawn(function() SendMessageToFirebase(text) end)
end)

ChatInputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        local text = ChatInputBox.Text
        ChatInputBox.Text = ""
        task.spawn(function() SendMessageToFirebase(text) end)
    end
end)


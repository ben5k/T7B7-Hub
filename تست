local function customRequest(options)
    local req = request or http_request or (syn and syn.request) or (http and http.request) or (fluxus and fluxus.request)
    if req then
        local success, response = pcall(function() return req(options) end)
        if success and response then return response end
    end
    if options.Method == "GET" then
        local success, body = pcall(function() return game:HttpGet(options.Url) end)
        if success then return {StatusCode = 200, Body = body} end
    end
    return {StatusCode = 400, Body = "null"}
end

local function safeDecode(jsonStr)
    if not jsonStr or jsonStr == "" or jsonStr == "null" then return nil end
    local success, result = pcall(function() return HttpService:JSONDecode(jsonStr) end)
    if success then return result end
    return nil
end

local function fetchAsset(url, fileName)
    local assetGetter = getcustomasset or getsynasset
    if type(writefile) == "function" and type(assetGetter) == "function" then
        local ext = string.lower(url:match("%.([%w]+)[%?#]?.*$") or "png")
        if ext ~= "png" and ext ~= "jpg" and ext ~= "jpeg" and ext ~= "webp" then ext = "png" end
        local file = "KEONHub_" .. fileName .. "." .. ext
        local haveFile = false
        if type(isfile) == "function" then
            pcall(function() haveFile = isfile(file) end)
        end

        if not haveFile then
            local response = customRequest({Url = url, Method = "GET"})
            local body = response and response.Body
            local isGoodBody = type(body) == "string" and #body > 128
            if isGoodBody then
                local sample = string.lower(body:sub(1, 200))
                if sample:find("<html", 1, true) or sample:find("access denied", 1, true) then
                    isGoodBody = false
                end
            end
            if isGoodBody then
                local saved = pcall(function() writefile(file, body) end)
                if saved then haveFile = true end
            end
        end

        if haveFile then
            local assetOk, assetPath = pcall(function() return assetGetter(file) end)
            if assetOk and type(assetPath) == "string" and assetPath ~= "" then
                return assetPath
            end
        end
    end
    -- Some Delta builds support URL-based images; other builds need getcustomasset/getsynasset.
    return url
end


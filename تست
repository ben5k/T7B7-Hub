-- 2. تحديد مسار تشغيل الواجهة (يعمل في Roblox Studio والأجزيكوتر)
local ParentTarget = (gethui and gethui()) or (syn and syn.protect_gui and syn.protect_gui(ScreenGui)) or game:GetService("CoreGui") or LocalPlayer:WaitForChild("PlayerGui")

-- حذف الواجهة القديمة إذا كانت موجودة
if ParentTarget:FindFirstChild("MapScriptHub") then
    ParentTarget.MapScriptHub:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "MapScriptHub"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = ParentTarget

-- الإطار الرئيسي (Main Frame)

local function loadUserSettings()
    if readfile and isfile and isfile(CONFIG_FILE) then
        pcall(function()
            local cfg = safeDecode(readfile(CONFIG_FILE))
            if cfg then
                selectedScriptBgIndex = cfg.scriptBg or 0
                selectedChatBgIndex = cfg.chatBg or 0
                KEONProfile.selectedCountryFlag = cfg.countryFlag or KEONProfile.selectedCountryFlag
                KEONProfile.selectedCountryName = cfg.countryName or KEONProfile.selectedCountryName

    titleShadow.Text = HUB_TITLE
    titleShadow.TextColor3 = Color3.fromRGB(14, 60, 150)
    titleShadow.TextTransparency = 0.45
    titleShadow.Font = Enum.Font.GothamBlack
    titleShadow.TextSize = 46
    titleShadow.ZIndex = 6
    titleShadow.Parent = LoadFrame
    local Title = titleShadow:Clone()
    Title.Position = UDim2.new(0, 0, 0, 99)
    Title.TextColor3 = WHITE
    Title.TextTransparency = 0
    Title.ZIndex = 7
    Title.Parent = LoadFrame

    -- الإطارات حول الشريط
    local barStroke = Instance.new("UIStroke")
    barStroke.Color = WHITE

local function register(card, row, o) table.insert(card.Elements, { Frame = row, Text = string.lower((o.Title or o.Text or "") .. " " .. (o.Description or "")) }) end
local function textBlock(parent, o, size)
	local f = new("Frame", { BackgroundTransparency = 1, Size = size, AutomaticSize = Y, Parent = parent }, { list(2) })
	if o.Title then bind(label({ TextSize = 13, Weight = "ExtraBold", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, TextColor3 = o.TitleColor or Theme.Text, LayoutOrder = 1, Parent = f }), o.Title) end
	if o.Description then bind(label({ Weight = "Medium", TextSize = 11, TextColor3 = Theme.Muted, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Y, TextWrapped = true, LayoutOrder = 2, Parent = f }), o.Description) end
	return f
end

function Card:AddToggle(o)
	local state = o.Default == true
	local row = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), AutomaticSize = Y, Parent = self.Body })
	textBlock(row, o, UDim2.new(1, -60, 0, 0))
	local sw = new("TextButton", { Size = UDim2.fromOffset(50, 26), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 2), BackgroundColor3 = state and Theme.Accent or Theme.Off, Text = "", AutoButtonColor = false, Parent = row }, { corner(13), stroke(Theme.CardStroke, 2) })
	local knob = new("Frame", { Size = UDim2.fromOffset(20, 20), AnchorPoint = Vector2.new(0, 0.5), Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Theme.White, Parent = sw }, { corner(10), stroke(Theme.CardStroke, 1.5) })
	local obj = {}
	function obj.Set(v, silent) state = v and true or false; tween(sw, 0.18, { BackgroundColor3 = state and Theme.Accent or Theme.Off }):Play(); tween(knob, 0.2, { Position = state and UDim2.new(1, -23, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, Enum.EasingStyle.Back):Play(); if not silent then fire(o.Callback, state) end end
	function obj.Get() return state end
	sw.MouseButton1Click:Connect(function() obj.Set(not state) end); pressFx(sw, 0.06); register(self, row, o); return obj
end


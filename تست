--[[
    VERSION: 8V  |  REXEL DIRECT-BACKGROUND FIX
    CHANGELOG:
      8V: Automatically downloads the exact Top4Top image to executor storage,
          converts it with getcustomasset/getsynasset, and displays it.
      7V: Previous interface layout and fallback background.

    REXEL | STEAL AN EGG UI
    Arabic Roblox interface based on the supplied reference.

    IMPORTANT:
      - The direct Top4Top URL is loaded automatically only in executors that
        provide request + writefile + getcustomasset (or getsynasset).
      - A normal Roblox Studio LocalScript cannot download a web JPG and turn
        it into an ImageLabel asset. Studio requires a Roblox image asset ID.
      - If the executor blocks Top4Top or lacks those APIs, the interface
        remains usable and shows the built-in background.
]]

-- VERSION: 8V
local BACKGROUND_URL = "https://d.top4top.io/p_3956imcxl0.jpg"
local BACKGROUND_FILE = "REXEL_BACKGROUND_8V.jpg"

-- Executor-only web-image loader. Returns a custom local asset URI on success.
local function loadRemoteBackground()
    local env = _G
    pcall(function()
        if type(getgenv) == "function" then
            env = getgenv()
        elseif type(getfenv) == "function" then
            env = getfenv()
        end
    end)

    local requestFn = env.request or env.http_request or env.httpRequest
    if not requestFn and type(env.syn) == "table" then
        requestFn = env.syn.request
    end
    if not requestFn and type(env.http) == "table" then
        requestFn = env.http.request
    end

    local writeFn = env.writefile
    local assetFn = env.getcustomasset or env.getsynasset
    local isFileFn = env.isfile

    if type(writeFn) ~= "function" or type(assetFn) ~= "function" then
        return nil, "المنفّذ لا يدعم getcustomasset و writefile"
    end

    -- Use a previously downloaded copy when available.
    if type(isFileFn) == "function" then
        local okExists, exists = pcall(isFileFn, BACKGROUND_FILE)
        if okExists and exists then
            local okCached, cachedUri = pcall(assetFn, BACKGROUND_FILE)
            if okCached and type(cachedUri) == "string" then
                return cachedUri
            end
        end
    end

    local body
    if type(requestFn) == "function" then
        local okRequest, response = pcall(function()
            return requestFn({
                Url = BACKGROUND_URL,
                Method = "GET"
            })
        end)

        if okRequest and type(response) == "table" then
            local statusCode = tonumber(response.StatusCode or response.Status or 200)
            if statusCode and statusCode ~= 200 then
                return nil, "رابط الصورة أعاد حالة HTTP " .. tostring(statusCode)
            end
            body = response.Body or response.body
        end
    end

    -- Some executors expose game:HttpGet even when request() is unavailable.
    if type(body) ~= "string" and game.HttpGet then
        local okGet, responseBody = pcall(function()
            return game:HttpGet(BACKGROUND_URL)
        end)
        if okGet then body = responseBody end
    end

    if type(body) ~= "string" or #body < 1000 then
        return nil, "تعذر تنزيل الصورة من الرابط"
    end

    local okWrite = pcall(function()
        writeFn(BACKGROUND_FILE, body)
    end)
    if not okWrite then
        return nil, "تعذر حفظ الصورة في ملفات المنفّذ"
    end

    local okAsset, assetUri = pcall(function()
        return assetFn(BACKGROUND_FILE)
    end)
    if not okAsset or type(assetUri) ~= "string" then
        return nil, "تعذر تحويل الصورة إلى أصل محلي"
    end

    return assetUri
end





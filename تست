applyResponsiveHelp = function()
    local width, height = getHelpPanelSize()
    HelpPanel.Position = UDim2.new(0.5, -math.floor(width / 2), 0.5, -math.floor(height / 2))
    HelpPanel.Size = UDim2.new(0, width, 0, height)
    HelpBody.Size = UDim2.new(1, -32, 0, math.max(120, height - 136))
    HelpBody.TextSize = width < 350 and 11 or 12
    HelpFoot.TextSize = width < 350 and 8 or 9
end

